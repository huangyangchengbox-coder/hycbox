# 复制为 upload-weixin.env（已 gitignore），填本地私钥路径后使用
# 私钥下载：微信公众平台 → 开发管理 → 开发设置 → 小程序代码上传密钥

# 必填：上传密钥文件绝对路径（勿提交仓库）
WEIXIN_PRIVATE_KEY_PATH=D:/codes/hycbox/private.wxd67a23406d6c3174.key

# 可选：覆盖默认 AppID（默认读 project.config.json）
# WEIXIN_APPID=wxd67a23406d6c3174

# 可选：版本号（默认读 package.json version，或用时间戳）
# WEIXIN_VERSION=1.0.1

# 可选：上传备注
# WEIXIN_DESC=仙途一章一局

# 可选：机器人编号 1–30（需在公众平台先启用对应机器人）
# WEIXIN_ROBOT=1
