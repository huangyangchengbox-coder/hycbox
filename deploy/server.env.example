# 复制到服务器 /opt/hycbox/server.env 并填入真实值（勿提交仓库）
# chmod 600 /opt/hycbox/server.env

HYCBOX_DB_URL=jdbc:mysql://127.0.0.1:3306/hycbox?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
HYCBOX_DB_USER=hycbox
HYCBOX_DB_PASSWORD=

# 体验环境见 deploy/setup-trial-env.js：独立库 hycbox_trial、进程 8081、路径 /api-trial/
# 清理业务测试数据：deploy/purge-biz-data.sql（保留 admin_user / admin_region）

HYCBOX_ADMIN_PASSWORD=
HYCBOX_WX_APP_ID=
HYCBOX_WX_APP_SECRET=
HYCBOX_WX_SUBSCRIBE_TEMPLATE_ID=

# 对外域名
HYCBOX_PUBLIC_BASE_URL=https://hychyr.top/api
HYCBOX_UPLOAD_PUBLIC_URL=https://hychyr.top/uploads
# 体验环境（trial.hychyr.top / 8081）示例：
# HYCBOX_PUBLIC_BASE_URL=https://trial.hychyr.top/api
# HYCBOX_UPLOAD_PUBLIC_URL=https://trial.hychyr.top/uploads
# HYCBOX_WX_MP_ENV_VERSION=trial
HYCBOX_STORAGE_TYPE=seaweedfs
HYCBOX_SEAWEEDFS_FILER_URL=http://127.0.0.1:8888

# 物品详情 / Agnes AI（OpenAI 兼容）
# HYCBOX_AI_API_KEY=
# HYCBOX_AI_BASE_URL=https://apihub.agnes-ai.com/v1
# HYCBOX_AI_MODEL=agnes-2.0-flash

# Cloudflare Workers AI（管理端 /ai-cloudflare）
# HYCBOX_CF_ACCOUNT_ID=
# HYCBOX_CF_API_TOKEN=
# HYCBOX_CF_DEFAULT_MODEL=@cf/meta/llama-3.1-8b-instruct

# NVIDIA NIM（管理端 /ai-nvidia-nim）https://build.nvidia.com/explore/discover
# HYCBOX_NVIDIA_NIM_API_KEY=
# HYCBOX_NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# HYCBOX_NVIDIA_NIM_DEFAULT_MODEL=meta/llama-3.1-8b-instruct

# 本机执行 deploy/*.js 时需要
# HYC_SSH_PASSWORD=
# HYC_SSH_HOST=hychyr.top
# HYC_GITEA_ADMIN_PASS=
# HYC_GITEA_SECRET_KEY=
