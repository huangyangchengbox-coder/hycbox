<view class="page">
  <view class="card">
    <view class="label">当前位置</view>
    <view class="value" wx:if="{{locating}}">定位中…</view>
    <block wx:else>
      <view class="coords">
        <text>纬度 {{latitude || '--'}}</text>
        <text>经度 {{longitude || '--'}}</text>
      </view>
      <view class="accuracy" wx:if="{{accuracy}}">精度约 ±{{accuracy}} 米</view>
      <view class="error" wx:if="{{error}}">{{error}}</view>
    </block>
  </view>

  <view class="actions">
    <button class="btn primary" bindtap="refresh" loading="{{locating}}">重新定位</button>
    <button class="btn" bindtap="openMap" disabled="{{!latitude}}">打开地图</button>
    <button class="btn" bindtap="copyCoords" disabled="{{!latitude}}">复制坐标</button>
  </view>
  <view class="tip">用于查看当前位置坐标，可一键打开微信地图。</view>
</view>
