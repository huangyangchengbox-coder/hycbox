.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
  background: #f5f6f8;
  display: flex;
  flex-direction: column;
}

.readout {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.cm {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.mm {
  font-size: 26rpx;
  color: #888;
}

.board {
  flex: 1;
  min-height: 620rpx;
  background: repeating-linear-gradient(
    90deg,
    #fff 0,
    #fff 19rpx,
    #e5e7eb 19rpx,
    #e5e7eb 20rpx
  );
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
}

.hint {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  color: #9ca3af;
  font-size: 26rpx;
}

.line {
  position: absolute;
  height: 4px;
  background: #0f766e;
  transform-origin: 0 50%;
  border-radius: 4px;
  box-shadow: 0 0 8px rgba(15, 118, 110, 0.35);
}

.dot {
  position: absolute;
  width: 16px;
  height: 16px;
  margin-left: -8px;
  margin-top: -8px;
  border-radius: 50%;
  background: #14b8a6;
  border: 2px solid #fff;
  box-shadow: 0 0 0 2px rgba(20, 184, 166, 0.35);
}

.tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

.btn {
  margin-top: 24rpx !important;
  background: #fff !important;
  color: #1a1a1a !important;
  border-radius: 14rpx !important;
}
