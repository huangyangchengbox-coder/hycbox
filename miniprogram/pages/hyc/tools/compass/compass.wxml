<view class="page">
  <view class="compass-wrap">
    <view class="ring">
      <text class="dir n">N</text>
      <text class="dir e">E</text>
      <text class="dir s">S</text>
      <text class="dir w">W</text>
      <view class="dial" style="transform: rotate({{rotate}}deg);">
        <view class="needle"></view>
      </view>
    </view>
    <view class="degree">{{degreeText}}</view>
    <view class="dir-name">{{directionName}}</view>
  </view>
  <view class="tip">请平放手机；初次使用需授权设备方向传感器。</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>
