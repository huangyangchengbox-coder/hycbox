.page {
  min-height: 100vh;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  background: #0f172a;
  color: #e2e8f0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.compass-wrap {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ring {
  width: 480rpx;
  height: 480rpx;
  border-radius: 50%;
  border: 4rpx solid #334155;
  background: radial-gradient(circle at 50% 45%, #1e293b 0%, #0f172a 70%);
  position: relative;
  box-shadow: inset 0 0 40rpx rgba(0, 0, 0, 0.35);
}

.dir {
  position: absolute;
  font-size: 28rpx;
  font-weight: 700;
  color: #94a3b8;
}

.dir.n {
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #f87171;
}

.dir.e {
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
}

.dir.s {
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
}

.dir.w {
  left: 28rpx;
  top: 50%;
  transform: translateY(-50%);
}

.dial {
  position: absolute;
  inset: 60rpx;
  border-radius: 50%;
  transition: transform 0.12s linear;
}

.needle {
  position: absolute;
  left: 50%;
  top: 8rpx;
  width: 8rpx;
  height: 46%;
  margin-left: -4rpx;
  background: linear-gradient(180deg, #ef4444 0%, #f87171 55%, #94a3b8 55%, #64748b 100%);
  border-radius: 8rpx;
  transform-origin: bottom center;
}

.degree {
  margin-top: 48rpx;
  font-size: 64rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.dir-name {
  margin-top: 8rpx;
  font-size: 32rpx;
  color: #94a3b8;
}

.tip,
.error {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #64748b;
  text-align: center;
  line-height: 1.5;
}

.error {
  color: #f87171;
}
