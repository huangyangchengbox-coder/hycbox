.xian-page {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  height: 100vh;
  background: #5c8a3a;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 顶栏：与 canvas 分栏，避免被 type=2d 原生层盖住 */
.top-chrome {
  flex-shrink: 0;
  z-index: 5;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  padding: calc(12rpx + env(safe-area-inset-top)) 16rpx 12rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #0f172a 0%, #1a2332 100%);
  border-bottom: 1rpx solid rgba(248, 250, 252, 0.12);
}

.hud {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-content: flex-start;
  gap: 6rpx 14rpx;
  padding-top: 6rpx;
  font-size: 20rpx;
  color: #d7e0ea;
  pointer-events: none;
}

.hud-item {
  white-space: nowrap;
}

.realm-btn {
  flex-shrink: 0;
  width: 112rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #f8fafc;
  background-color: #334155;
  border-radius: 10rpx;
}

.realm-btn-skip {
  color: #1c1917;
  background-color: #fbbf24;
}

.tip-bar {
  flex-shrink: 0;
  padding: 8rpx 20rpx 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(203, 213, 225, 0.85);
  background: #15202b;
  pointer-events: none;
}

.tip-bar-quote {
  color: #fde68a;
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
  letter-spacing: 1rpx;
}

.game-area {
  position: relative;
  flex: 1;
  min-height: 0;
  width: 100%;
}

.canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* 进场选档 / 境界面板：铺满居中 */
.gate-screen,
.panel-screen {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: calc(24rpx + env(safe-area-inset-top)) 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(165deg, #1a2332 0%, #0f172a 45%, #1c1917 100%);
}

.gate-screen {
  align-items: center;
  justify-content: center;
}

.chapter-pick-screen {
  align-items: stretch;
  justify-content: flex-start;
  max-width: 100%;
}

.chapter-pick-screen .info-title,
.chapter-pick-screen .info-sub {
  text-align: center;
}

.gate-title {
  font-size: 56rpx;
  font-weight: 600;
  color: #f8fafc;
  letter-spacing: 8rpx;
  margin-bottom: 20rpx;
}

.gate-sub {
  font-size: 26rpx;
  color: #94a3b8;
  margin-bottom: 64rpx;
}

.gate-btn-main {
  width: 420rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 34rpx;
  color: #1c1917;
  background: #fbbf24;
  border-radius: 12rpx;
  margin-bottom: 28rpx;
}

.gate-btn-sub {
  width: 420rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  color: #e2e8f0;
  background: rgba(51, 65, 85, 0.95);
  border-radius: 12rpx;
}

.info-title {
  text-align: center;
  font-size: 36rpx;
  color: #f8fafc;
  margin-bottom: 12rpx;
  flex-shrink: 0;
}

.info-sub {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.panel-scroll {
  flex: 1;
  height: 0;
  min-height: 200rpx;
}

.info-group {
  margin-bottom: 24rpx;
}

.info-group-title {
  font-size: 28rpx;
  color: #fbbf24;
  margin-bottom: 12rpx;
}

.info-row {
  margin-bottom: 18rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.info-name {
  font-size: 26rpx;
  color: #e2e8f0;
  margin-bottom: 6rpx;
}

.info-meta {
  font-size: 22rpx;
  color: #cbd5e1;
  line-height: 1.4;
  margin-bottom: 4rpx;
}

.info-desc {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.45;
}

.info-desc.tip-line {
  color: #fde68a;
  margin-top: 4rpx;
}

.pick-row {
  margin-bottom: 12rpx;
  padding: 20rpx 18rpx;
  background-color: rgba(30, 41, 59, 0.95);
  border-radius: 10rpx;
}

.pick-name {
  font-size: 30rpx;
  color: #f8fafc;
  margin-bottom: 6rpx;
}

.pick-meta {
  font-size: 22rpx;
  color: #94a3b8;
}

.info-close {
  flex-shrink: 0;
  margin: 24rpx auto 0;
  width: 280rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 30rpx;
  color: #f8fafc;
  background-color: #334155;
  border-radius: 10rpx;
}

.mask-panel {
  align-items: center;
  justify-content: center;
  background: rgba(236, 230, 216, 0.92);
}

.ink-epitaph {
  text-align: center;
  font-size: 88rpx;
  font-weight: bold;
  color: #0c0c0c;
  letter-spacing: 16rpx;
}

.mask-sub {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #3f3f46;
}

.mask-btn {
  margin-top: 56rpx;
  width: 280rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 30rpx;
  color: #f5f0e6;
  background-color: #1c1c1c;
  border-radius: 8rpx;
}

.mask-sub.soft {
  margin-top: 12rpx;
  color: #71717a;
  font-size: 22rpx;
}

/* —— 一章一局 —— */
.chapter-pick-screen .panel-scroll {
  margin-bottom: 16rpx;
}

.chapter-batch {
  margin-bottom: 20rpx;
}

.chapter-batch-title {
  font-size: 26rpx;
  color: #fbbf24;
  margin: 8rpx 0 12rpx;
  letter-spacing: 2rpx;
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
}

.chapter-row {
  margin-bottom: 12rpx;
  padding: 20rpx 18rpx;
  background-color: rgba(30, 41, 59, 0.95);
  border-radius: 10rpx;
  border-left: 6rpx solid #fbbf24;
}

.chapter-row-cleared {
  border-left-color: #4ade80;
  opacity: 0.92;
}

.chapter-row-locked {
  border-left-color: #475569;
  opacity: 0.55;
}

.chapter-row-main {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.chapter-row-code {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #fbbf24;
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
}

.chapter-row-title {
  font-size: 30rpx;
  color: #f8fafc;
}

.chapter-row-meta {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.chapter-tag {
  font-size: 22rpx;
  color: #94a3b8;
}

.chapter-status {
  font-size: 22rpx;
  color: #cbd5e1;
}

.chapter-pick-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.chapter-reset {
  width: 100%;
  max-width: 420rpx;
  margin-bottom: 0;
}

.story-screen,
.story-fill {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 0;
  background: #78a0ff;
}

.story-sky {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, #78a0ff 0%, #8eb4ff 42%, #5c8a3a 42.2%, #5c8a3a 70%, #6b4f2a 70%, #6b4f2a 100%);
}

.story-scene-village .story-sky {
  background: linear-gradient(180deg, #78a0ff 0%, #a8c4ff 40%, #5c8a3a 40.2%, #5c8a3a 68%, #6b4f2a 68%, #6b4f2a 100%);
}
.story-scene-cliff .story-sky {
  background: linear-gradient(180deg, #6ec6ff 0%, #9ad8ff 38%, #7a7a7a 38.2%, #5a5a5a 62%, #3d3d3d 62%, #3d3d3d 100%);
}
.story-scene-bottle .story-sky {
  background: linear-gradient(180deg, #1a3d2e 0%, #0d2818 45%, #14532d 45.2%, #166534 100%);
}
.story-scene-meditate .story-sky {
  background: linear-gradient(180deg, #0b1020 0%, #1a2340 40%, #2d3748 40.2%, #1a202c 100%);
}
.story-scene-boss .story-sky {
  background: linear-gradient(180deg, #2a0a0a 0%, #1c1917 40%, #3f1d1d 40.2%, #1c1917 100%);
}
.story-scene-spirit .story-sky,
.story-scene-ink .story-sky,
.story-scene-battle .story-sky,
.story-scene-spar .story-sky {
  background: linear-gradient(180deg, #78a0ff 0%, #8eb4ff 40%, #5c8a3a 40.2%, #5c8a3a 68%, #6b4f2a 68%, #6b4f2a 100%);
}

/* 棋盘格草地（我的世界感） */
.mc-ground {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 32%;
  background-image:
    linear-gradient(90deg, rgba(0,0,0,0.06) 50%, transparent 50%),
    linear-gradient(rgba(0,0,0,0.06) 50%, transparent 50%);
  background-size: 48rpx 48rpx;
  background-color: #5c8a3a;
  pointer-events: none;
  z-index: 0;
}
.story-scene-cliff .mc-ground {
  background-color: #7a7a7a;
}
.story-scene-meditate .mc-ground,
.story-scene-boss .mc-ground {
  background-color: #2d3748;
}
.story-scene-bottle .mc-ground {
  background-color: #166534;
}

/* 场景靠右下，给左上文字让位 */
.story-stage,
.mc-stage {
  position: absolute;
  left: 28%;
  right: 0;
  top: 28%;
  bottom: 4%;
  pointer-events: none;
  z-index: 1;
}

.mc-tag {
  position: absolute;
  left: 50%;
  bottom: -36rpx;
  transform: translateX(-50%);
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #fff;
  background: rgba(15, 23, 42, 0.78);
  white-space: nowrap;
  z-index: 5;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.mc-prop {
  position: absolute;
}

/* —— 方块场景（更易辨认） —— */
.mc-block {
  position: absolute;
  box-sizing: border-box;
  border: 3rpx solid rgba(0, 0, 0, 0.28);
  border-top-color: rgba(255, 255, 255, 0.3);
  border-left-color: rgba(255, 255, 255, 0.18);
}
.mc-stone { background: #9ca3af; }
.mc-dirt { background: #a16207; }
.mc-obsidian { background: #4c1d95; box-shadow: 0 0 24rpx rgba(167, 139, 250, 0.55); }

.mc-cloud {
  position: absolute;
  background: #fff;
  opacity: 0.95;
  box-shadow: 28rpx 0 0 #fff, 56rpx 0 0 #fff, 14rpx 18rpx 0 #fff, 42rpx 18rpx 0 #fff;
  width: 28rpx;
  height: 18rpx;
  animation: mcCloud 18s linear infinite;
  top: 4%;
}
.mc-cloud-1 { left: 8%; }
.mc-cloud-2 { left: 55%; animation-duration: 22s; animation-delay: -6s; }
@keyframes mcCloud {
  from { transform: translateX(0); }
  to { transform: translateX(40rpx); }
}

/* 树：树冠三层 + 树干 */
.mc-tree {
  bottom: 6%;
  width: 36rpx;
  height: 180rpx;
}
.mc-tree-l { left: 6%; }
.mc-tree-r { right: 8%; }
.mc-trunk {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 28rpx;
  height: 64rpx;
  margin-left: -14rpx;
  background: #7c4a1e;
  border: 3rpx solid rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
}
.mc-leaves {
  position: absolute;
  left: 50%;
  top: 0;
  width: 100rpx;
  height: 100rpx;
  margin-left: -50rpx;
  background: #22c55e;
  border: 3rpx solid rgba(0, 0, 0, 0.25);
  box-shadow:
    0 28rpx 0 -8rpx #16a34a,
    0 52rpx 0 -20rpx #15803d,
    inset 8rpx 8rpx 0 rgba(255, 255, 255, 0.2);
  box-sizing: border-box;
}

/* 木屋：屋顶三角感 + 墙 + 窗 + 门 */
.mc-house {
  left: 38%;
  bottom: 6%;
  width: 160rpx;
  height: 140rpx;
}
.mc-house-roof {
  position: absolute;
  left: -20rpx;
  top: 0;
  width: 200rpx;
  height: 44rpx;
  background: #b91c1c;
  border: 3rpx solid rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
  z-index: 2;
}
.mc-house-wall {
  position: absolute;
  left: 0;
  top: 40rpx;
  width: 160rpx;
  height: 100rpx;
  background: #d6a35a;
  border: 3rpx solid rgba(0, 0, 0, 0.28);
  box-sizing: border-box;
  box-shadow: inset -12rpx 0 0 rgba(0, 0, 0, 0.12);
}
.mc-house-win {
  position: absolute;
  top: 58rpx;
  width: 28rpx;
  height: 28rpx;
  background: #7dd3fc;
  border: 3rpx solid #422006;
  z-index: 2;
  box-sizing: border-box;
}
.mc-house-win-l { left: 24rpx; }
.mc-house-win-r { right: 24rpx; }
.mc-house-door {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 40rpx;
  height: 56rpx;
  margin-left: -20rpx;
  background: #5c3a1e;
  border: 3rpx solid #292524;
  border-bottom: 0;
  z-index: 2;
  box-sizing: border-box;
}

/* 小人：头+身+手脚+眼睛 */
.mc-mob {
  bottom: 8%;
  width: 48rpx;
  height: 120rpx;
  z-index: 3;
}
.mc-mob-head {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  background: #e0a060;
  border: 3rpx solid rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
  z-index: 2;
}
.mc-eye {
  position: absolute;
  top: 18rpx;
  width: 8rpx;
  height: 10rpx;
  background: #0f172a;
}
.mc-eye-l { left: 10rpx; }
.mc-eye-r { right: 10rpx; }
.mc-eye-red { background: #ef4444; }
.mc-mob-body {
  width: 48rpx;
  height: 44rpx;
  background: #2563eb;
  border: 3rpx solid rgba(0, 0, 0, 0.3);
  border-top: 0;
  box-sizing: border-box;
}
.mc-mob-arm {
  position: absolute;
  top: 50rpx;
  width: 16rpx;
  height: 40rpx;
  background: #e0a060;
  border: 2rpx solid rgba(0, 0, 0, 0.25);
  box-sizing: border-box;
  z-index: 1;
}
.mc-arm-l { left: -14rpx; }
.mc-arm-r { right: -14rpx; }
.mc-mob-leg {
  position: absolute;
  bottom: 0;
  width: 20rpx;
  height: 28rpx;
  background: #1e3a5f;
  border: 2rpx solid rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
}
.mc-leg-l { left: 2rpx; }
.mc-leg-r { right: 2rpx; }

.mc-steve { left: 18%; animation: mcBob 1.4s ease-in-out infinite; }
.mc-climb { left: 42%; bottom: 42%; }
.mc-sit { left: 50%; margin-left: -24rpx; bottom: 18%; height: 96rpx; }
.mc-sit .mc-mob-body { height: 36rpx; }
.mc-hero-side { left: 10%; }
.mc-foe { right: 10%; }
.mc-foe .mc-mob-head { background: #65a30d; }
.mc-foe .mc-mob-body { background: #3f6212; }
.mc-foe .mc-mob-arm { background: #65a30d; }
.mc-boss {
  left: 52%;
  width: 88rpx;
  height: 160rpx;
  bottom: 10%;
}
.mc-boss .mc-mob-head {
  width: 88rpx;
  height: 64rpx;
  background: #171717;
  box-shadow: 0 0 28rpx rgba(248, 113, 113, 0.55);
}
.mc-boss .mc-mob-body {
  width: 88rpx;
  height: 72rpx;
  background: #7f1d1d;
}
.mc-boss .mc-tag { bottom: -36rpx; }

@keyframes mcBob {
  from { transform: translateY(0); }
  to { transform: translateY(-8rpx); }
}

/* 石崖阶梯 */
.mc-cliff {
  right: 2%;
  bottom: 0;
  width: 52%;
  height: 92%;
}
.mc-tag-cliff {
  left: auto;
  right: 8%;
  bottom: 8%;
  transform: none;
}
.mc-b1 { right: 0; bottom: 0; width: 100%; height: 26%; }
.mc-b2 { right: 0; bottom: 26%; width: 84%; height: 18%; }
.mc-b3 { right: 0; bottom: 44%; width: 66%; height: 16%; }
.mc-b4 { right: 0; bottom: 60%; width: 48%; height: 14%; }
.mc-b5 { right: 0; bottom: 74%; width: 32%; height: 12%; background: #854d0e; }

/* 竹：杆 + 叶 */
.mc-bamboo {
  bottom: 6%;
  width: 20rpx;
  background: linear-gradient(180deg, #4ade80 0%, #15803d 100%);
  border: 3rpx solid rgba(0, 0, 0, 0.25);
  box-sizing: border-box;
  animation: bambooSway 2.8s ease-in-out infinite;
  transform-origin: bottom center;
}
.mc-bamboo-1 { left: 4%; height: 55%; }
.mc-bamboo-2 { left: 14%; height: 68%; animation-direction: reverse; }
.mc-bamboo-leaf {
  position: absolute;
  top: 12%;
  left: 18rpx;
  width: 36rpx;
  height: 14rpx;
  background: #22c55e;
  border: 2rpx solid rgba(0, 0, 0, 0.2);
}
.mc-bamboo .mc-tag { bottom: -32rpx; }
@keyframes bambooSway {
  from { transform: rotate(-3deg); }
  to { transform: rotate(3deg); }
}

.mc-glow-pad {
  position: absolute;
  left: 50%;
  top: 18%;
  width: 240rpx;
  height: 240rpx;
  margin-left: -120rpx;
  background: radial-gradient(circle, rgba(74, 222, 128, 0.55), transparent 70%);
  animation: glowPulse 2.4s ease-in-out infinite;
}
@keyframes glowPulse {
  0%, 100% { transform: scale(0.92); opacity: 0.7; }
  50% { transform: scale(1.08); opacity: 1; }
}

/* 瓶：口-颈-肚 可辨认 */
.mc-bottle {
  left: 50%;
  bottom: 14%;
  width: 100rpx;
  height: 160rpx;
  margin-left: -50rpx;
}
.mc-bottle-mouth {
  position: absolute;
  left: 50%;
  top: 0;
  width: 36rpx;
  height: 14rpx;
  margin-left: -18rpx;
  background: #86efac;
  border: 3rpx solid rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
}
.mc-bottle-neck {
  position: absolute;
  left: 50%;
  top: 12rpx;
  width: 28rpx;
  height: 36rpx;
  margin-left: -14rpx;
  background: #4ade80;
  border: 3rpx solid rgba(0, 0, 0, 0.28);
  border-bottom: 0;
  box-sizing: border-box;
}
.mc-bottle-body {
  position: absolute;
  left: 0;
  top: 44rpx;
  width: 100rpx;
  height: 116rpx;
  background: linear-gradient(180deg, #4ade80, #15803d);
  border: 3rpx solid rgba(0, 0, 0, 0.3);
  box-shadow: 0 0 40rpx rgba(74, 222, 128, 0.75);
  box-sizing: border-box;
}
.mc-bottle-shine {
  position: absolute;
  left: 18rpx;
  top: 58rpx;
  width: 14rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.5);
  z-index: 2;
}
.mc-bottle .mc-tag { bottom: -40rpx; }

.mc-spark {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  background: #bbf7d0;
  border: 2rpx solid rgba(0, 0, 0, 0.2);
  animation: sparkFloat 2s ease-in-out infinite;
}
.mc-spark-1 { left: 28%; top: 22%; }
.mc-spark-2 { left: 66%; top: 18%; animation-delay: 0.4s; }
.mc-spark-3 { left: 48%; top: 8%; animation-delay: 0.8s; }
@keyframes sparkFloat {
  from { transform: translateY(0); opacity: 0.4; }
  to { transform: translateY(-24rpx); opacity: 1; }
}

.mc-moon {
  right: 10%;
  top: 2%;
  width: 72rpx;
  height: 72rpx;
  background: #fef08a;
  border: 3rpx solid rgba(0, 0, 0, 0.2);
  box-shadow: 0 0 40rpx rgba(254, 249, 195, 0.65);
  box-sizing: border-box;
}
.mc-moon .mc-tag { bottom: -34rpx; }

.mc-seat {
  left: 50%;
  bottom: 6%;
  width: 140rpx;
  height: 32rpx;
  margin-left: -70rpx;
}
.mc-seat .mc-tag { bottom: -34rpx; }

.mc-aura {
  position: absolute;
  left: 50%;
  bottom: 20%;
  width: 160rpx;
  height: 160rpx;
  margin-left: -80rpx;
  background: radial-gradient(circle, rgba(125, 211, 252, 0.45), transparent 70%);
  animation: glowPulse 3s ease-in-out infinite;
}

.mc-rift {
  position: absolute;
  left: 48%;
  top: 0;
  width: 20rpx;
  height: 100%;
  margin-left: -10rpx;
  background: linear-gradient(180deg, transparent, #f87171 20%, #ef4444 50%, #f87171 80%, transparent);
  opacity: 0.85;
  animation: riftFlicker 1.2s ease-in-out infinite;
}
@keyframes riftFlicker {
  0%, 100% { opacity: 0.35; transform: scaleY(0.92); }
  50% { opacity: 0.95; transform: scaleY(1); }
}

.mc-slash-beam {
  position: absolute;
  left: 12%;
  top: 42%;
  width: 70%;
  height: 14rpx;
  background: #fde68a;
  transform: rotate(-18deg);
  animation: slashFlash 1.8s ease-in-out infinite;
}
@keyframes slashFlash {
  0%, 70%, 100% { opacity: 0; }
  78%, 88% { opacity: 1; }
}

/* 剑：刃 + 护手 + 柄 */
.mc-sword {
  left: 48%;
  bottom: 28%;
  width: 40rpx;
  height: 160rpx;
  margin-left: -20rpx;
  animation: swordFloat 2.6s ease-in-out infinite;
}
.mc-sword-blade {
  position: absolute;
  left: 50%;
  top: 0;
  width: 18rpx;
  height: 100rpx;
  margin-left: -9rpx;
  background: linear-gradient(180deg, #f8fafc, #94a3b8);
  border: 2rpx solid rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
}
.mc-sword-guard {
  position: absolute;
  left: 50%;
  top: 96rpx;
  width: 40rpx;
  height: 14rpx;
  margin-left: -20rpx;
  background: #ca8a04;
  border: 2rpx solid rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
}
.mc-sword-hilt {
  position: absolute;
  left: 50%;
  top: 108rpx;
  width: 16rpx;
  height: 44rpx;
  margin-left: -8rpx;
  background: #78350f;
  border: 2rpx solid rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
}
.mc-sword .mc-tag { bottom: -36rpx; }
@keyframes swordFloat {
  from { transform: translateY(0); }
  to { transform: translateY(-12rpx); }
}

/* —— 像素精灵舞台（1-A） —— */
.sprite-stage {
  position: absolute;
  left: 28%;
  right: 0;
  top: 26%;
  bottom: 4%;
  z-index: 1;
  pointer-events: none;
  image-rendering: pixelated;
}
.sp {
  position: absolute;
  image-rendering: pixelated;
}
.sp-cloud {
  width: 120rpx;
  height: 48rpx;
  opacity: 0.95;
  animation: mcCloud 16s linear infinite;
}
.sp-cloud-1 { left: 8%; top: 4%; }
.sp-cloud-2 { left: 48%; top: 12%; animation-duration: 22s; }
.sp-ground-row {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 48rpx;
  display: flex;
  flex-direction: row;
}
.sp-grass {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  image-rendering: pixelated;
}
.sp-tree {
  width: 120rpx;
  height: 180rpx;
  bottom: 40rpx;
}
.sp-tree-l { left: 4%; }
.sp-tree-r { right: 6%; }
.sp-house {
  width: 220rpx;
  height: 180rpx;
  left: 34%;
  bottom: 40rpx;
}
.sp-steve {
  width: 72rpx;
  height: 144rpx;
  left: 18%;
  bottom: 44rpx;
  animation: mcBob 1.2s ease-in-out infinite;
}
.sp-walk {
  animation: spWalk 2.4s ease-in-out infinite;
}
@keyframes spWalk {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(36rpx); }
}
.sp-badge {
  position: absolute;
  right: 16rpx;
  bottom: 56rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #fef9c3;
  background: rgba(15, 23, 42, 0.75);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  z-index: 6;
}

/* —— 自研 Canvas：下半屏满宽（不与左上旁白重叠） —— */
.canvas-stage,
.canvas-stage-full {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 58%;
  z-index: 1;
  pointer-events: none;
  background: #0f172a;
  overflow: hidden;
}
.canvas-anim {
  width: 100%;
  height: 100%;
  display: block;
}
.story-sky-fallback {
  background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
}
.story-render-canvas .story-ui-tl {
  max-height: 40%;
  overflow: hidden;
}

.story-fx-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 28%;
  pointer-events: none;
  z-index: 2;
}

.sfx {
  position: absolute;
}

.sfx-slash {
  left: 18%;
  top: 42%;
  width: 64%;
  height: 10rpx;
  background: linear-gradient(90deg, transparent, #fde68a, #fff, #fde68a, transparent);
  transform: rotate(-22deg);
  animation: sfxSlash 0.7s ease-out;
}

@keyframes sfxSlash {
  0% { opacity: 0; transform: rotate(-22deg) scaleX(0.2); }
  35% { opacity: 1; transform: rotate(-22deg) scaleX(1); }
  100% { opacity: 0; transform: rotate(-22deg) translateX(8%) scaleX(1.05); }
}

.sfx-glow-ring {
  left: 50%;
  top: 38%;
  width: 200rpx;
  height: 200rpx;
  margin: -100rpx 0 0 -100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(125, 211, 252, 0.65);
  box-shadow: 0 0 40rpx rgba(125, 211, 252, 0.45);
  animation: sfxGlowRing 1.2s ease-out;
}

@keyframes sfxGlowRing {
  from { transform: scale(0.4); opacity: 0.9; }
  to { transform: scale(1.5); opacity: 0; }
}

.sfx-quake {
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(248, 250, 252, 0.08);
  animation: sfxQuake 0.55s ease-out;
}

@keyframes sfxQuake {
  0%, 100% { transform: translate(0, 0); opacity: 0; }
  20% { transform: translate(-8rpx, 4rpx); opacity: 1; }
  40% { transform: translate(8rpx, -4rpx); opacity: 0.8; }
  60% { transform: translate(-4rpx, -2rpx); opacity: 0.5; }
}

.sfx-walk-dust {
  left: 42%;
  bottom: 8%;
  width: 80rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(226, 232, 240, 0.35);
  animation: sfxWalk 1s ease-out;
}

@keyframes sfxWalk {
  from { transform: translateX(0) scale(0.6); opacity: 0.6; }
  to { transform: translateX(60rpx) scale(1.2); opacity: 0; }
}

.story-act-climb .mc-climb {
  animation: mcBob 0.9s ease-in-out infinite;
}

.story-act-pulse .mc-glow-pad,
.story-act-pulse .mc-aura,
.story-act-pulse .mc-bottle {
  animation-duration: 1.1s;
}

.story-act-spar .mc-sword {
  animation: swordFloat 0.7s ease-in-out infinite;
}

.story-ui,
.story-ui-tl {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 62%;
  max-width: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  padding: calc(20rpx + env(safe-area-inset-top)) 24rpx 24rpx 28rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, rgba(7, 10, 18, 0.82) 0%, rgba(7, 10, 18, 0.55) 70%, transparent 100%);
  pointer-events: none;
}

.story-auto-hint {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: rgba(226, 232, 240, 0.55);
  letter-spacing: 1rpx;
}

.story-fx-on .story-stage,
.story-fx-on .story-ui {
  animation: storyFadeIn 0.55s ease both;
}

.story-fx-out {
  animation: storyFadeOut 0.4s ease both;
}

@keyframes storyFadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes storyFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

.story-chapter {
  font-size: 22rpx;
  color: #fbbf24;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
}

.story-title {
  font-size: 40rpx;
  color: #f8fafc;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
  text-align: left;
}

.story-goal {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 16rpx;
  text-align: left;
}

.story-text {
  width: 100%;
  max-height: 42vh;
  overflow: hidden;
  font-size: 28rpx;
  line-height: 1.65;
  color: #e2e8f0;
  text-align: left;
  margin-bottom: 12rpx;
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
  word-break: break-word;
}

.story-next {
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 32rpx;
  color: #1c1917;
  background: #fbbf24;
  border-radius: 12rpx;
}

.story-fight {
  width: 100%;
  margin-bottom: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.fight-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.fight-actor {
  width: 96rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 0;
  font-size: 24rpx;
  color: #f8fafc;
  border: 3rpx solid rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
}

.fight-hero {
  background: #3b6ea5;
  box-shadow: inset -8rpx -8rpx 0 rgba(0, 0, 0, 0.15);
}

.fight-foe {
  background: #7f1d1d;
  box-shadow: inset -8rpx -8rpx 0 rgba(0, 0, 0, 0.2);
  animation: foePulse 1.1s ease-in-out infinite;
}

@keyframes foePulse {
  from { transform: scale(1); }
  to { transform: scale(1.04); }
}

.fight-vs {
  font-size: 28rpx;
  color: #fbbf24;
  letter-spacing: 4rpx;
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
}

.fight-bar-wrap {
  width: 100%;
  height: 16rpx;
  border-radius: 8rpx;
  background: rgba(51, 65, 85, 0.9);
  overflow: hidden;
  margin-bottom: 12rpx;
}

.fight-bar {
  height: 100%;
  background: linear-gradient(90deg, #fbbf24, #f87171);
  transition: width 0.15s ease;
}

.fight-hint {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 20rpx;
}

.story-fight-btn {
  background: #f87171;
  color: #fff7ed;
}

.chapter-clear-anim {
  position: relative;
  overflow: hidden;
}

.clear-ink-ring {
  position: absolute;
  left: 50%;
  top: 38%;
  width: 280rpx;
  height: 280rpx;
  margin: -140rpx 0 0 -140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(28, 28, 28, 0.2);
  animation: inkRing 0.9s ease-out both;
  pointer-events: none;
}

@keyframes inkRing {
  from { transform: scale(0.4); opacity: 0.8; }
  to { transform: scale(1.6); opacity: 0; }
}

.chapter-clear-anim .ink-epitaph {
  animation: storyFadeIn 0.5s ease both;
}
