.xian-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #1a3d24;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 顶栏：与 canvas 分栏，避免被 type=2d 原生层盖住 */
.top-chrome {
  flex-shrink: 0;
  z-index: 5;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  padding: calc(12rpx + env(safe-area-inset-top)) 16rpx 12rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #0f172a 0%, #1a2332 100%);
  border-bottom: 1rpx solid rgba(248, 250, 252, 0.12);
}

.hud {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-content: flex-start;
  gap: 6rpx 14rpx;
  padding-top: 6rpx;
  font-size: 20rpx;
  color: #d7e0ea;
  pointer-events: none;
}

.hud-item {
  white-space: nowrap;
}

.realm-btn {
  flex-shrink: 0;
  width: 112rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #f8fafc;
  background-color: #334155;
  border-radius: 10rpx;
}

.realm-btn-skip {
  color: #1c1917;
  background-color: #fbbf24;
}

.tip-bar {
  flex-shrink: 0;
  padding: 8rpx 20rpx 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(203, 213, 225, 0.85);
  background: #15202b;
  pointer-events: none;
}

.tip-bar-quote {
  color: #fde68a;
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
  letter-spacing: 1rpx;
}

.game-area {
  position: relative;
  flex: 1;
  min-height: 0;
  width: 100%;
}

.canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* 进场选档 / 境界面板：无 canvas */
.gate-screen,
.panel-screen {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: calc(48rpx + env(safe-area-inset-top)) 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(165deg, #1a2332 0%, #0f172a 45%, #1c1917 100%);
}

.gate-screen {
  align-items: center;
  justify-content: center;
}

.gate-title {
  font-size: 56rpx;
  font-weight: 600;
  color: #f8fafc;
  letter-spacing: 8rpx;
  margin-bottom: 20rpx;
}

.gate-sub {
  font-size: 26rpx;
  color: #94a3b8;
  margin-bottom: 64rpx;
}

.gate-btn-main {
  width: 420rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 34rpx;
  color: #1c1917;
  background: #fbbf24;
  border-radius: 12rpx;
  margin-bottom: 28rpx;
}

.gate-btn-sub {
  width: 420rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  color: #e2e8f0;
  background: rgba(51, 65, 85, 0.95);
  border-radius: 12rpx;
}

.info-title {
  text-align: center;
  font-size: 36rpx;
  color: #f8fafc;
  margin-bottom: 12rpx;
  flex-shrink: 0;
}

.info-sub {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.panel-scroll {
  flex: 1;
  height: 0;
  min-height: 200rpx;
}

.info-group {
  margin-bottom: 24rpx;
}

.info-group-title {
  font-size: 28rpx;
  color: #fbbf24;
  margin-bottom: 12rpx;
}

.info-row {
  margin-bottom: 18rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.info-name {
  font-size: 26rpx;
  color: #e2e8f0;
  margin-bottom: 6rpx;
}

.info-meta {
  font-size: 22rpx;
  color: #cbd5e1;
  line-height: 1.4;
  margin-bottom: 4rpx;
}

.info-desc {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.45;
}

.info-desc.tip-line {
  color: #fde68a;
  margin-top: 4rpx;
}

.pick-row {
  margin-bottom: 12rpx;
  padding: 20rpx 18rpx;
  background-color: rgba(30, 41, 59, 0.95);
  border-radius: 10rpx;
}

.pick-name {
  font-size: 30rpx;
  color: #f8fafc;
  margin-bottom: 6rpx;
}

.pick-meta {
  font-size: 22rpx;
  color: #94a3b8;
}

.info-close {
  flex-shrink: 0;
  margin: 24rpx auto 0;
  width: 280rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 30rpx;
  color: #f8fafc;
  background-color: #334155;
  border-radius: 10rpx;
}

.mask-panel {
  align-items: center;
  justify-content: center;
  background: rgba(236, 230, 216, 0.92);
}

.ink-epitaph {
  text-align: center;
  font-size: 88rpx;
  font-weight: bold;
  color: #0c0c0c;
  letter-spacing: 16rpx;
}

.mask-sub {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #3f3f46;
}

.mask-btn {
  margin-top: 56rpx;
  width: 280rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 30rpx;
  color: #f5f0e6;
  background-color: #1c1c1c;
  border-radius: 8rpx;
}
