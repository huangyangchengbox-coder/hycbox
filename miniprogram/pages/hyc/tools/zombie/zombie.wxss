.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #1a3d24;
  overflow: hidden;
  box-sizing: border-box;
}

.hud {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8rpx 16rpx;
  padding: 16rpx 28rpx;
  font-size: 22rpx;
  color: #d7e0ea;
  background: linear-gradient(180deg, rgba(15, 20, 25, 0.85), transparent);
  pointer-events: none;
}

.hud-item {
  white-space: nowrap;
}

/* cover-view：固定尺寸 + 纯色背景，避免被同层 canvas 吃掉 */
.ctrl-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(72rpx + env(safe-area-inset-bottom));
  z-index: 20;
  height: 48rpx;
  display: flex;
  flex-direction: row;
  justify-content: center;
}

.ctrl-btn {
  width: 140rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin: 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #f8fafc;
  background-color: rgba(15, 23, 42, 0.82);
  border-radius: 6rpx;
}

.tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 2;
  text-align: center;
  font-size: 22rpx;
  color: rgba(203, 213, 225, 0.75);
  pointer-events: none;
}

.canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.info-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  background-color: rgba(15, 18, 22, 0.82);
  padding: 48rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.info-title {
  text-align: center;
  font-size: 36rpx;
  color: #f8fafc;
  margin-bottom: 20rpx;
}

.info-scroll {
  height: 72%;
  overflow-y: scroll;
}

.info-group {
  margin-bottom: 24rpx;
}

.info-group-title {
  font-size: 28rpx;
  color: #fbbf24;
  margin-bottom: 12rpx;
}

.info-row {
  margin-bottom: 18rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.info-name {
  font-size: 26rpx;
  color: #e2e8f0;
  margin-bottom: 6rpx;
}

.info-desc {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.45;
}

.info-close {
  margin: 28rpx auto 0;
  width: 240rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 28rpx;
  color: #f8fafc;
  background-color: #334155;
  border-radius: 8rpx;
}

/* cover-view 样式需偏简单，才能稳定盖在 type=2d canvas 上 */
.mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9;
  background-color: rgba(236, 230, 216, 0.55);
}

.ink-epitaph {
  margin-top: 36%;
  text-align: center;
  font-size: 88rpx;
  font-weight: bold;
  color: #0c0c0c;
  letter-spacing: 16rpx;
}

.mask-sub {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #3f3f46;
}

.mask-btn {
  margin: 56rpx auto 0;
  width: 280rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 30rpx;
  color: #f5f0e6;
  background-color: #1c1c1c;
  border-radius: 8rpx;
}
