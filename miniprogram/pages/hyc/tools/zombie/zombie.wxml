<!-- 仙途主界面 -->
<view class="xian-page">
  <view class="hud">
    <view class="hud-item">击杀 {{kills}}</view>
    <view class="hud-item">{{realmTierName}} · {{realmName}}</view>
    <view class="hud-item">飞剑 ×{{swordCount}}</view>
    <view class="hud-item">灵气 {{lingQi}}/{{maxLingQi}}</view>
    <view class="hud-item" wx:if="{{heldFu}}">符 · {{heldFu}}</view>
    <view class="hud-item">波次 {{wave}}</view>
  </view>

  <canvas
    type="2d"
    id="gameCanvas"
    class="canvas"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchEnd"
  ></canvas>

  <!-- 左上角：境界详情 -->
  <cover-view class="realm-btn" wx:if="{{!over && !perfect && !showRealmInfo}}" bindtap="toggleRealmInfo">境界</cover-view>

  <view class="tip" wx:if="{{!over && !perfect && !showRealmInfo && realmName === '凡人'}}">盘膝吸纳天地灵气 · 僵尸之手伤不得你</view>
  <view class="tip" wx:elif="{{!over && !perfect && !showRealmInfo && heldFu}}">点按落点扔出「{{heldFu}}」</view>
  <view class="tip" wx:elif="{{!over && !perfect && !showRealmInfo && (realmName === '炼气' || realmName === '筑基' || realmName === '结丹')}}">御剑耗灵气 · 静止打坐回灵 · 出土剑/丹药/符箓</view>
  <view class="tip" wx:elif="{{!over && !perfect && !showRealmInfo}}">点按顺移 · 持符点按释放 · 左下太极切换自动</view>

  <cover-view class="info-mask" wx:if="{{showRealmInfo && !over && !perfect}}">
    <cover-view class="info-title">修仙境界</cover-view>
    <cover-view class="info-scroll">
      <cover-view wx:for="{{realmInfoList}}" wx:key="title" class="info-group">
        <cover-view class="info-group-title">{{item.title}}</cover-view>
        <cover-view wx:for="{{item.items}}" wx:for-item="r" wx:key="name" class="info-row">
          <cover-view class="info-name">{{r.name}}期 · 击杀{{r.kills}}+</cover-view>
          <cover-view class="info-desc">{{r.desc}}</cover-view>
        </cover-view>
      </cover-view>
    </cover-view>
    <cover-view class="info-close" bindtap="closeRealmInfo">关闭</cover-view>
  </cover-view>

  <cover-view class="mask" wx:if="{{perfect}}">
    <cover-view class="ink-epitaph">大圆满</cover-view>
    <cover-view class="mask-sub">道祖 · 击杀 {{kills}}</cover-view>
    <cover-view class="mask-btn" bindtap="restart">再修一回</cover-view>
  </cover-view>

  <cover-view class="mask" wx:if="{{over && !perfect}}">
    <cover-view class="ink-epitaph">大道无情</cover-view>
    <cover-view class="mask-sub">击杀 {{kills}} · 境界 {{realmName}}</cover-view>
    <cover-view class="mask-btn" bindtap="restart">再修一回</cover-view>
  </cover-view>
</view>
