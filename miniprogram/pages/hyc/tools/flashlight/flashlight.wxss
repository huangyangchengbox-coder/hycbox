.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: background 0.2s;
}

.page.off {
  background: #111;
}

.page.on {
  background: #fff;
}

.hidden-cam {
  position: fixed;
  width: 1px;
  height: 1px;
  left: -20px;
  top: -20px;
  opacity: 0;
}

.bulb {
  margin-top: 120rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #333;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.35);
}

.page.on .bulb {
  background: #fbbf24;
  box-shadow: 0 0 80rpx rgba(251, 191, 36, 0.75);
}

.bulb-inner {
  font-size: 48rpx;
  font-weight: 700;
  color: #eee;
}

.page.on .bulb-inner {
  color: #78350f;
}

.mode-row {
  margin-top: 64rpx;
  display: flex;
  gap: 20rpx;
}

.mode {
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #cbd5e1;
}

.page.on .mode {
  background: #f3f4f6;
  color: #666;
}

.mode.active {
  background: #0f766e;
  color: #fff;
}

.page.on .mode.active {
  background: #0f766e;
  color: #fff;
}

.tip,
.error {
  margin-top: 40rpx;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.5;
  color: #94a3b8;
  max-width: 560rpx;
}

.page.on .tip {
  color: #6b7280;
}

.error {
  color: #f87171;
}
