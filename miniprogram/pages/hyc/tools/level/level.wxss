.page {
  min-height: 100vh;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  background: #ecfeff;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status {
  font-size: 36rpx;
  font-weight: 700;
  color: #0e7490;
  margin-bottom: 40rpx;
}

.status.ok {
  color: #059669;
}

.stage {
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #fff 0%, #e0f2fe 70%, #bae6fd 100%);
  border: 8rpx solid #67e8f9;
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 0 30rpx rgba(14, 116, 144, 0.12);
}

.cross-h,
.cross-v {
  position: absolute;
  background: rgba(14, 116, 144, 0.2);
}

.cross-h {
  left: 10%;
  right: 10%;
  top: 50%;
  height: 2rpx;
}

.cross-v {
  top: 10%;
  bottom: 10%;
  left: 50%;
  width: 2rpx;
}

.bubble {
  position: absolute;
  width: 72rpx;
  height: 72rpx;
  margin-left: -36rpx;
  margin-top: -36rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #ecfeff, #22d3ee 55%, #0891b2);
  box-shadow: 0 4rpx 16rpx rgba(8, 145, 178, 0.35);
  transition: left 0.08s linear, top 0.08s linear;
}

.angles {
  margin-top: 40rpx;
  display: flex;
  gap: 40rpx;
  font-size: 28rpx;
  color: #0e7490;
  font-variant-numeric: tabular-nums;
}

.tip,
.error {
  margin-top: 36rpx;
  font-size: 24rpx;
  color: #64748b;
  text-align: center;
  line-height: 1.5;
}

.error {
  color: #dc2626;
}
