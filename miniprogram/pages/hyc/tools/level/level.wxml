<view class="page">
  <view class="status {{isLevel ? 'ok' : ''}}">{{statusText}}</view>
  <view class="stage">
    <view class="cross-h"></view>
    <view class="cross-v"></view>
    <view class="bubble" style="left:{{bubbleLeft}}%;top:{{bubbleTop}}%;"></view>
  </view>
  <view class="angles">
    <text>X {{angleX}}°</text>
    <text>Y {{angleY}}°</text>
  </view>
  <view class="tip">将手机平放在桌面；气泡靠近中心即接近水平。</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>
