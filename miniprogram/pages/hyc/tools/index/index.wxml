<view class="tools-page">
  <view class="tools-hero">
    <view class="tools-title">实用工具</view>
    <view class="tools-sub">定位 · 指南针 · 尺子 · 水平仪 · 手电筒 · 计时器 · 仙途 · 道途</view>
  </view>

  <view class="tools-grid">
    <view class="tool-card" bindtap="goLocator">
      <view class="tool-icon loc">◎</view>
      <view class="tool-name">定位器</view>
      <view class="tool-desc">查看坐标，打开地图</view>
    </view>
    <view class="tool-card" bindtap="goCompass">
      <view class="tool-icon comp">✦</view>
      <view class="tool-name">指南针</view>
      <view class="tool-desc">实时方位朝向</view>
    </view>
    <view class="tool-card" bindtap="goRuler">
      <view class="tool-icon ruler">═</view>
      <view class="tool-name">尺子</view>
      <view class="tool-desc">屏幕测距（参考）</view>
    </view>
    <view class="tool-card" bindtap="goLevel">
      <view class="tool-icon level">◯</view>
      <view class="tool-name">水平仪</view>
      <view class="tool-desc">检测平面是否水平</view>
    </view>
    <view class="tool-card" bindtap="goFlashlight">
      <view class="tool-icon flash">☀</view>
      <view class="tool-name">手电筒</view>
      <view class="tool-desc">屏幕光 / 闪光灯</view>
    </view>
    <view class="tool-card" bindtap="goTimer">
      <view class="tool-icon timer">⏱</view>
      <view class="tool-name">计时器</view>
      <view class="tool-desc">秒表与倒计时</view>
    </view>
    <view class="tool-card" wx:if="{{showXian}}" bindtap="goZombie">
      <view class="tool-icon zombie">仙</view>
      <view class="tool-name">仙途</view>
      <view class="tool-desc">章节故事 · 自研Canvas · 一章一局</view>
    </view>
    <view class="tool-card" wx:if="{{showXian}}" bindtap="goDaotu">
      <view class="tool-icon daotu">道</view>
      <view class="tool-name">道途</view>
      <view class="tool-desc">无尽斩尸 · 打坐突破 · 原仙途玩法</view>
    </view>
  </view>
</view>
