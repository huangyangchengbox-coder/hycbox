@import "../../common.wxss";

.stock-row {
  margin-top: 12rpx;
}

.img-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.detail-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.tip {
  margin-top: 12rpx;
  color: #999;
}

.content {
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: #1a1a1a;
  white-space: pre-wrap;
  word-break: break-word;
}

.err {
  font-size: 28rpx;
  color: #cf1322;
  line-height: 1.6;
}

.retry {
  margin-top: 24rpx;
}
