<view class="hyc-page">
  <view class="hyc-card" wx:if="{{title}}">
    <view class="hyc-title">{{title}}</view>
    <view class="hyc-sub" wx:if="{{cached}}">已缓存详情，无需再次识别</view>
    <view class="hyc-sub" wx:elif="{{!loading && content}}">本次由 AI 识别生成并已保存</view>
  </view>

  <view class="hyc-card" wx:if="{{loading}}">
    <view class="hyc-empty">正在识别图片并生成介绍…</view>
    <view class="hyc-sub tip">首次可能需要十几秒，之后会直接读取缓存</view>
  </view>

  <view class="hyc-card" wx:if="{{!loading && content}}">
    <view class="content">{{content}}</view>
    <view class="hyc-sub tip" wx:if="{{updatedAt}}">更新时间：{{updatedAt}}</view>
  </view>

  <view class="hyc-card" wx:if="{{!loading && error}}">
    <view class="err">{{error}}</view>
    <button class="hyc-btn-primary retry" bindtap="reload">重试</button>
  </view>
</view>
