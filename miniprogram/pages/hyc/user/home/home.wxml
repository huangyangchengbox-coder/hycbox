<view class="hyc-page">
  <view class="hyc-card" wx:for="{{publications}}" wx:key="id">
    <image class="hyc-fruit-img" src="{{item.imageUrl}}" mode="aspectFill" />
    <view class="hyc-title" style="margin-top:16rpx">{{item.title}}</view>
    <view class="hyc-sub">发布时间：{{item.createdAt}}</view>
    <view class="hyc-row">
      <text>剩余 <text class="hyc-stat-num">{{item.remainBags}}</text> 袋</text>
      <text class="hyc-sub">共 {{item.totalBags}} 袋</text>
    </view>
    <button
      class="hyc-btn-primary"
      data-id="{{item.id}}"
      bindtap="goOrder"
      disabled="{{item.remainBags <= 0}}"
    >
      {{item.remainBags > 0 ? '立即领取' : '已领完'}}
    </button>
  </view>

  <view class="hyc-empty" wx:if="{{!loading && publications.length === 0}}">
    暂无水果发布，请稍后再来
  </view>

  <view class="hyc-bottom-bar">
    <view class="hyc-bottom-item active">首页</view>
    <view class="hyc-bottom-item" bindtap="goMine">我的订单</view>
    <view class="hyc-bottom-item" bindtap="switchRole">切换身份</view>
  </view>
</view>
