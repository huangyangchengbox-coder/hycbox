<view class="hyc-page">
  <view class="hyc-card" wx:for="{{publications}}" wx:key="id">
    <image wx:if="{{item.imageUrl}}" class="hyc-fruit-img" src="{{item.imageUrl}}" mode="aspectFill" />
    <view class="hyc-title" style="margin-top:16rpx">{{item.title}}</view>
    <view class="hyc-sub">发布人：{{item.adminName || '管理者'}} · {{item.createdAt}}</view>
    <view class="hyc-row">
      <text>剩余 <text class="hyc-stat-num">{{item.remainBags}}</text> {{item.unit || '袋'}}</text>
      <text class="hyc-sub">共 {{item.totalBags}} {{item.unit || '袋'}}</text>
    </view>
    <button
      class="hyc-btn-primary"
      data-id="{{item.id}}"
      data-can="{{item.remainBags > 0 ? '1' : '0'}}"
      bindtap="goOrder"
      disabled="{{item.remainBags <= 0}}"
    >
      {{item.remainBags > 0 ? '登记派送' : '已领完'}}
    </button>
  </view>

  <view class="hyc-empty" wx:if="{{!loading && publications.length === 0}}">
    暂无物品发布，请稍后再来
  </view>

  <view class="hyc-bottom-bar">
    <view class="hyc-bottom-item active">首页</view>
    <view class="hyc-bottom-item" bindtap="goMine">我的订单</view>
    <view class="hyc-bottom-item" bindtap="goProfile">我的</view>
  </view>
</view>
