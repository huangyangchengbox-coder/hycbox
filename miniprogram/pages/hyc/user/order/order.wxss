@import "../../common.wxss";

.address-head {
  align-items: flex-start;
}

.address-actions {
  display: flex;
  gap: 24rpx;
  flex-shrink: 0;
}

.link-btn {
  font-size: 28rpx;
  color: #2f6bff;
  line-height: 1.4;
}

.link-btn.muted {
  color: #999;
}

.tip-temp {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.address-default {
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  line-height: 1.5;
}

.tip-selected {
  margin-top: 20rpx;
}

.picker-label {
  font-size: 26rpx;
  color: #666;
  margin-top: 20rpx;
}

.picker-value {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 8rpx;
  font-size: 28rpx;
}

.divider {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  margin: 32rpx 0 16rpx;
}

.quantity-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.quantity-num {
  font-size: 40rpx;
  font-weight: 700;
  margin: 0 40rpx;
  min-width: 60rpx;
  text-align: center;
}

.submit-btn {
  margin: 24rpx;
}
