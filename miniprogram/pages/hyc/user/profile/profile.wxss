@import "../../common.wxss";

.menu-card {
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-main {
  flex: 1;
  padding-right: 16rpx;
  min-width: 0;
}

.menu-title {
  font-size: 30rpx;
  color: #1a1a1a;
}

.menu-tip {
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
  line-height: 1;
}
