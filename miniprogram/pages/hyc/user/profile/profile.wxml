<view class="hyc-page">
  <view class="hyc-card">
    <view class="hyc-title">我的</view>
    <view class="hyc-sub">邻里信息备忘录 · 用户端</view>
  </view>

  <view class="hyc-card menu-card">
    <view class="menu-item" bindtap="goChangeCommunity">
      <view>
        <view class="menu-title">我的小区</view>
        <view class="hyc-sub">{{communityLabel}}</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAdmin">
      <view>
        <view class="menu-title">进入管理者</view>
        <view class="hyc-sub">发布物品 / 配送管理</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="hyc-bottom-bar">
    <view class="hyc-bottom-item" bindtap="goHome">首页</view>
    <view class="hyc-bottom-item" bindtap="goOrders">我的订单</view>
    <view class="hyc-bottom-item active">我的</view>
  </view>
</view>
