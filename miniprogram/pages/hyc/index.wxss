@import "./common.wxss";

.hero {
  background: linear-gradient(135deg, #07c160, #06ad56);
  padding: 80rpx 40rpx 60rpx;
  color: #fff;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  opacity: 0.9;
}

.role-btn {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  text-align: left;
  line-height: 1.4;
}

.role-btn.user {
  background: #f6ffed;
  color: #135200;
}

.role-btn.admin {
  background: #e6f7ff;
  color: #003a8c;
}

.role-name {
  font-size: 32rpx;
  font-weight: 600;
}

.role-desc {
  font-size: 24rpx;
  margin-top: 8rpx;
  opacity: 0.8;
}

.info-card .info-row {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.info-card .info-row:first-child {
  margin-top: 0;
}
