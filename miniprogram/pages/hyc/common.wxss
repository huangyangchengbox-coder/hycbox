.hyc-page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.hyc-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.hyc-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.hyc-sub {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

.hyc-btn-primary {
  background: #07c160 !important;
  color: #fff !important;
  border-radius: 12rpx;
}

.hyc-btn-plain {
  background: #fff !important;
  color: #07c160 !important;
  border: 1rpx solid #07c160 !important;
  border-radius: 12rpx;
}

.hyc-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.hyc-tag-pending {
  background: #fff7e6;
  color: #fa8c16;
}

.hyc-tag-done {
  background: #f6ffed;
  color: #52c41a;
}

.hyc-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 99;
}

.hyc-bottom-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: #666;
}

.hyc-bottom-item.active {
  color: #07c160;
  font-weight: 600;
}

.hyc-empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.hyc-input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}

.hyc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.hyc-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #07c160;
}

.hyc-fruit-img {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.hyc-search-result {
  max-height: 400rpx;
  overflow-y: auto;
  margin-top: 12rpx;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
}

.hyc-search-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.hyc-search-item:last-child {
  border-bottom: none;
}

.hyc-search-item.active {
  background: #f6ffed;
  color: #07c160;
}
