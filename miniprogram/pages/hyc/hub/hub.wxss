.hub-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 80rpx 40rpx 60rpx;
  background: linear-gradient(165deg, #e8f5ee 0%, #f5f6f8 42%, #eef2f7 100%);
}

.hub-hero {
  margin-bottom: 64rpx;
}

.hub-brand {
  font-size: 52rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.hub-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #666;
}

.weather-card {
  margin-bottom: 36rpx;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #e8f4ff 0%, #f0faf4 100%);
  box-shadow: 0 6rpx 20rpx rgba(47, 107, 255, 0.06);
}

.weather-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.weather-temp {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1;
  min-width: 120rpx;
}

.weather-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.weather-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.weather-extra {
  font-size: 22rpx;
  color: #666;
}

.weather-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #888;
}

.hub-grid {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.hub-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}

.hub-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 20rpx;
}

.hub-icon.house {
  background: #e8f8ef;
  color: #07c160;
}

.hub-icon.box {
  background: #eef3ff;
  color: #2f6bff;
}

.hub-icon.village {
  background: #fff7e6;
  color: #d48806;
}

.hub-icon.tools {
  background: #ecfeff;
  color: #0e7490;
}

.hub-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.hub-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
}

.hub-footer {
  margin-top: 72rpx;
  text-align: center;
  font-size: 26rpx;
  color: #07c160;
}
