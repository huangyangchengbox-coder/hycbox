.hub-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 80rpx 40rpx 60rpx;
  background: linear-gradient(165deg, #e8f5ee 0%, #f5f6f8 42%, #eef2f7 100%);
}

.hub-hero {
  margin-bottom: 64rpx;
}

.hub-brand {
  font-size: 52rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.hub-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #666;
}

.weather-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 36rpx;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #e8f4ff 0%, #f0faf4 100%);
  box-shadow: 0 6rpx 20rpx rgba(47, 107, 255, 0.06);
}

/* 按天气切换天空底色 */
.weather-card.sky-clear {
  background: linear-gradient(120deg, #d6ebff 0%, #eef9f2 100%);
}
.weather-card.sky-cloud {
  background: linear-gradient(120deg, #d5e0eb 0%, #e8eef3 100%);
}
.weather-card.sky-rain {
  background: linear-gradient(120deg, #9aafc4 0%, #c5d4e0 100%);
}
.weather-card.sky-storm {
  background: linear-gradient(120deg, #5a6a7c 0%, #8a9aaa 100%);
}
.weather-card.sky-storm .weather-temp,
.weather-card.sky-storm .weather-text {
  color: #f5f7fa;
}
.weather-card.sky-storm .weather-extra,
.weather-card.sky-storm .weather-tip {
  color: rgba(245, 247, 250, 0.75);
}

.weather-fx {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  z-index: 0;
}

.weather-body {
  position: relative;
  z-index: 1;
}

/* —— 云层漂移 —— */
.fx-clouds {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
}

.cloud {
  position: absolute;
  height: 48rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.55);
  animation: cloud-drift linear infinite;
}

.cloud .puff {
  position: absolute;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 50%;
}

.cloud .puff.a {
  width: 44rpx;
  height: 44rpx;
  top: -18rpx;
  left: 28rpx;
}

.cloud .puff.b {
  width: 60rpx;
  height: 60rpx;
  top: -26rpx;
  left: 56rpx;
}

.cloud.c1 {
  width: 140rpx;
  top: 18%;
  left: -30%;
  opacity: 0.7;
  animation-duration: 22s;
}

.cloud.c2 {
  width: 110rpx;
  top: 48%;
  left: -40%;
  opacity: 0.5;
  animation-duration: 30s;
  animation-delay: -8s;
}

.cloud.c3 {
  width: 160rpx;
  top: 68%;
  left: -35%;
  opacity: 0.4;
  animation-duration: 26s;
  animation-delay: -14s;
}

@keyframes cloud-drift {
  from { transform: translateX(0); }
  to { transform: translateX(160vw); }
}

/* —— 雨丝 —— */
.fx-rain {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
}

.drop {
  position: absolute;
  top: -20%;
  width: 2rpx;
  height: 28rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.55);
  animation: rain-fall 0.9s linear infinite;
}

@keyframes rain-fall {
  from { transform: translateY(0); opacity: 0.7; }
  to { transform: translateY(220%); opacity: 0.15; }
}

/* —— 闪电闪屏 —— */
.fx-lightning {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(255, 255, 255, 0.75);
  opacity: 0;
  animation: lightning-flash 4.5s ease-in-out infinite;
}

@keyframes lightning-flash {
  0%, 86%, 100% { opacity: 0; }
  87% { opacity: 0.72; }
  88% { opacity: 0.08; }
  89% { opacity: 0.55; }
  91% { opacity: 0; }
}

.weather-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.weather-temp {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1;
  min-width: 120rpx;
}

.weather-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.weather-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.weather-extra {
  font-size: 22rpx;
  color: #666;
}

.weather-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #888;
}

.hub-grid {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.hub-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}

.hub-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.hub-icon-glyph {
  position: relative;
  z-index: 1;
  line-height: 1;
}

.hub-icon.house {
  background: #e8f8ef;
  color: #07c160;
}

.hub-icon.box {
  background: #eef3ff;
  color: #2f6bff;
}

.hub-icon.village {
  background: #fff7e6;
  color: #d48806;
}

.hub-icon.tools {
  background: #ecfeff;
  color: #0e7490;
}

/* —— 图标微动效（业务语义差异） —— */
.hub-icon.house.hub-icon-anim .hub-icon-glyph {
  animation: icon-flash-pulse 2.4s ease-in-out infinite;
}

.hub-icon-spark {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(7, 193, 96, 0.55);
  opacity: 0;
  z-index: 0;
}

.hub-icon-spark.s1 {
  top: 14rpx;
  right: 16rpx;
  animation: icon-spark 2.4s ease-out infinite;
}

.hub-icon-spark.s2 {
  bottom: 18rpx;
  left: 14rpx;
  width: 8rpx;
  height: 8rpx;
  animation: icon-spark 2.4s ease-out 1.1s infinite;
}

.hub-icon.box.hub-icon-anim .hub-icon-glyph {
  animation: icon-ship-slide 2.8s ease-in-out infinite;
}

.hub-icon.village.hub-icon-anim .hub-icon-glyph {
  animation: icon-soft-bob 2.6s ease-in-out infinite;
}

.hub-icon.tools.hub-icon-anim .hub-icon-glyph {
  animation: icon-spin-nudge 4s ease-in-out infinite;
}

.hub-card-biz:active .hub-icon,
.hub-card:active .hub-icon {
  transform: scale(0.94);
  transition: transform 0.12s ease;
}

@keyframes icon-flash-pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  40% { transform: scale(1.08); opacity: 0.92; }
  55% { transform: scale(0.98); }
}

@keyframes icon-spark {
  0% { transform: scale(0.4); opacity: 0; }
  25% { opacity: 0.85; }
  70% { transform: scale(1.8); opacity: 0; }
  100% { opacity: 0; }
}

@keyframes icon-ship-slide {
  0%, 100% { transform: translateX(0); }
  35% { transform: translateX(6rpx); }
  70% { transform: translateX(-4rpx); }
}

@keyframes icon-soft-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

@keyframes icon-spin-nudge {
  0%, 70%, 100% { transform: rotate(0deg); }
  80% { transform: rotate(12deg); }
  90% { transform: rotate(-8deg); }
}

.hub-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.hub-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
}

.hub-footer {
  margin-top: 72rpx;
  text-align: center;
  font-size: 26rpx;
  color: #07c160;
}
