<view class="hub-page">
  <view class="hub-hero">
    <view class="hub-brand">备忘录</view>
    <view class="hub-sub">选择你要使用的服务</view>
  </view>

  <view class="weather-card {{weatherSky}}" bindtap="onWeatherTap">
    <view class="weather-fx">
      <view wx:if="{{fxCloud}}" class="fx-clouds">
        <view class="cloud c1"><view class="puff a"></view><view class="puff b"></view></view>
        <view class="cloud c2"><view class="puff a"></view><view class="puff b"></view></view>
        <view class="cloud c3"><view class="puff a"></view><view class="puff b"></view></view>
      </view>
      <view wx:if="{{fxRain}}" class="fx-rain">
        <view class="drop" wx:for="{{rainDrops}}" wx:key="*this" style="left:{{item}}%; animation-delay:{{index * 0.12}}s;"></view>
      </view>
      <view wx:if="{{fxLightning}}" class="fx-lightning"></view>
    </view>

    <view class="weather-body">
      <view class="weather-main" wx:if="{{weatherText}}">
        <text class="weather-temp">{{weatherTemp}}</text>
        <view class="weather-meta">
          <text class="weather-text">{{weatherText}}</text>
          <text class="weather-extra" wx:if="{{weatherExtra}}">{{weatherExtra}}</text>
        </view>
      </view>
      <view class="weather-tip">{{weatherTip}}</view>
    </view>
  </view>

  <view class="hub-grid">
    <view class="hub-card hub-card-biz" wx:if="{{showFlash}}" bindtap="goFlash">
      <view class="hub-icon house hub-icon-anim">
        <view class="hub-icon-glyph">⌂</view>
        <view class="hub-icon-spark s1"></view>
        <view class="hub-icon-spark s2"></view>
      </view>
      <view class="hub-title">小区闪送</view>
      <view class="hub-desc">邻里相间，闪电配送</view>
    </view>
    <view class="hub-card hub-card-biz" wx:if="{{showExpress}}" bindtap="goExpress">
      <view class="hub-icon box hub-icon-anim">
        <view class="hub-icon-glyph">▤</view>
      </view>
      <view class="hub-title">物流中国</view>
      <view class="hub-desc">快速记录，全国发货</view>
    </view>
    <view class="hub-card hub-card-biz" wx:if="{{showVillage}}" bindtap="goVillage">
      <view class="hub-icon village hub-icon-anim">
        <view class="hub-icon-glyph">⌂</view>
      </view>
      <view class="hub-title">村村送</view>
      <view class="hub-desc">选点定位，上门配送</view>
    </view>
    <view class="hub-card" bindtap="goTools">
      <view class="hub-icon tools hub-icon-anim">
        <view class="hub-icon-glyph">▣</view>
      </view>
      <view class="hub-title">实用工具</view>
      <view class="hub-desc">定位 · 指南针 · 尺子 · 水平仪 · 手电筒 · 计时器</view>
    </view>
  </view>

  <view class="hub-footer" bindtap="goProfile">我的 / 管理者入口 ›</view>
</view>
