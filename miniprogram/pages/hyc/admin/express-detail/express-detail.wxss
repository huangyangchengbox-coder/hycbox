@import "../../common.wxss";

.remark-area {
  margin-top: 16rpx;
  width: 100%;
  min-height: 160rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.picker-label {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #666;
}

.img-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.img-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  text-align: center;
  line-height: 40rpx;
  font-size: 28rpx;
}

.img-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #ddd;
  color: #999;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip-ship {
  margin-top: 8rpx;
  color: #666;
}

.ship-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.action-btn {
  background: #f7f8fa !important;
  color: #2f6bff !important;
}

.save-btn {
  margin-top: 28rpx;
}
