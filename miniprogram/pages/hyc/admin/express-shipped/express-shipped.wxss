@import "../../common.wxss";

.tab-row {
  display: flex;
  margin-top: 24rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 10rpx;
}

.tab-item.on {
  background: #fff;
  color: #07c160;
  font-weight: 600;
}

.tip-card {
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.order-card {
  padding-bottom: 20rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}

.detail-hint {
  margin-top: 12rpx;
  text-align: right;
  font-size: 24rpx;
  color: #2f6bff;
}
