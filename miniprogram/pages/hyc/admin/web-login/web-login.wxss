.auth-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 40rpx 80rpx;
  background: linear-gradient(180deg, #e8f8ef 0%, #f0f2f5 42%, #f0f2f5 100%);
}

.auth-hero {
  margin-top: 48rpx;
  text-align: center;
}

.auth-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-icon-monitor {
  width: 56rpx;
  height: 40rpx;
  border: 6rpx solid #07c160;
  border-radius: 8rpx;
  position: relative;
  box-sizing: border-box;
}

.auth-icon-monitor::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -18rpx;
  width: 28rpx;
  height: 8rpx;
  margin-left: -14rpx;
  background: #07c160;
  border-radius: 4rpx;
}

.auth-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
}

.auth-desc {
  margin: 16rpx 32rpx 0;
  font-size: 28rpx;
  line-height: 1.5;
  color: #666;
}

.auth-card {
  margin-top: 48rpx;
  padding: 8rpx 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.auth-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.auth-row:last-child {
  border-bottom: none;
}

.auth-label {
  font-size: 28rpx;
  color: #888;
}

.auth-value {
  font-size: 28rpx;
  color: #222;
  font-weight: 500;
}

.status-ok {
  color: #07c160;
}

.auth-tips {
  margin: 28rpx 8rpx 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: #999;
}

.auth-btn-confirm {
  margin-top: 56rpx;
  height: 96rpx !important;
  line-height: 96rpx !important;
  padding: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
  border-radius: 48rpx !important;
  background: #07c160 !important;
  color: #fff !important;
  font-size: 32rpx !important;
  font-weight: 600;
  border: none !important;
}

.auth-btn-confirm::after {
  border: none;
}

.auth-btn-confirm[disabled] {
  opacity: 0.55;
}

.auth-btn-cancel {
  margin-top: 24rpx;
  height: 88rpx !important;
  line-height: 88rpx !important;
  padding: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
  border-radius: 44rpx !important;
  background: transparent !important;
  color: #666 !important;
  font-size: 30rpx !important;
  border: none !important;
}

.auth-btn-cancel::after {
  border: none;
}
