<view class="auth-page">
  <view class="auth-hero">
    <view class="auth-icon-wrap">
      <view class="auth-icon-monitor"></view>
    </view>
    <view class="auth-title">电脑端登录确认</view>
    <view class="auth-desc">hycBox 管理后台请求使用你的管理员身份登录</view>
  </view>

  <view class="auth-card">
    <view class="auth-row">
      <text class="auth-label">登录来源</text>
      <text class="auth-value">网页管理端</text>
    </view>
    <view class="auth-row">
      <text class="auth-label">状态</text>
      <text class="auth-value status-ok">{{statusText}}</text>
    </view>
  </view>

  <view class="auth-tips">确认后，电脑浏览器将自动完成登录。如非本人操作请点取消。</view>

  <button
    class="auth-btn-confirm"
    bindtap="onConfirm"
    loading="{{loading}}"
    disabled="{{!ticket || loading}}"
  >确认登录</button>
  <button class="auth-btn-cancel" bindtap="goBack" disabled="{{loading}}">取消</button>
</view>
