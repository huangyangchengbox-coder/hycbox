@import "../../common.wxss";

.prompt-area {
  width: 100%;
  min-height: 160rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.gen-btn {
  margin-top: 24rpx;
}

.gen-btn-busy {
  opacity: 0.75;
}

.job-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.job-item.job-entering {
  animation: job-drop-in 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  background: #ecfdf5;
  border-radius: 12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

@keyframes job-drop-in {
  from {
    opacity: 0;
    transform: translateY(-24rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.job-item:last-child {
  border-bottom: none;
}

.job-img {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  margin-top: 12rpx;
}

.job-prompt {
  font-size: 28rpx;
  color: #333;
  margin-top: 8rpx;
  word-break: break-all;
}

.job-meta {
  margin-top: 8rpx;
}

.status-failed {
  background: #fff1f0;
  color: #ff4d4f;
}

.status-running {
  background: #e6f7ff;
  color: #1890ff;
}
