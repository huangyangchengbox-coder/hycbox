@import "../../common.wxss";

.prompt-area {
  width: 100%;
  min-height: 160rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.gen-btn {
  margin-top: 24rpx;
}

.gen-btn-busy {
  opacity: 0.75;
}

.job-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.job-item.job-entering {
  animation: job-drop-in 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  background: #ecfdf5;
  border-radius: 12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

@keyframes job-drop-in {
  from {
    opacity: 0;
    transform: translateY(-24rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.fly-layer {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;
  pointer-events: none;
}

.fly-trail {
  position: fixed;
  width: 10px;
  border-radius: 999px;
  background: linear-gradient(180deg, rgba(45, 212, 191, 0.1), rgba(16, 185, 129, 0.55));
  opacity: 0;
  transition: height 0.5s ease, opacity 0.5s ease;
}

.fly-card {
  position: fixed;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #ecfdf5, #e0f2fe);
  border: 1rpx solid rgba(16, 185, 129, 0.45);
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.16);
  overflow: hidden;
}

.fly-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #0f766e;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}

.fly-text {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #134e4a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-item:last-child {
  border-bottom: none;
}

.job-video {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  background: #000;
  margin-top: 12rpx;
}

.job-prompt {
  font-size: 28rpx;
  color: #333;
  margin-top: 8rpx;
  word-break: break-all;
}

.job-meta {
  margin-top: 8rpx;
}

.job-actions {
  margin-top: 12rpx;
}

.refresh-btn {
  margin: 0 !important;
  font-size: 24rpx !important;
  line-height: 2 !important;
  padding: 0 24rpx !important;
}

.status-failed {
  background: #fff1f0;
  color: #ff4d4f;
}

.status-running {
  background: #e6f7ff;
  color: #1890ff;
}
