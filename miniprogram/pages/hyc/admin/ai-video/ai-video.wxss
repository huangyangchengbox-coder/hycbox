@import "../../common.wxss";

.prompt-area {
  width: 100%;
  min-height: 160rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.gen-btn {
  margin-top: 24rpx;
}

.job-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.job-item:last-child {
  border-bottom: none;
}

.job-video {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  background: #000;
  margin-top: 12rpx;
}

.job-prompt {
  font-size: 28rpx;
  color: #333;
  margin-top: 8rpx;
  word-break: break-all;
}

.job-meta {
  margin-top: 8rpx;
}

.job-actions {
  margin-top: 12rpx;
}

.refresh-btn {
  margin: 0 !important;
  font-size: 24rpx !important;
  line-height: 2 !important;
  padding: 0 24rpx !important;
}

.status-failed {
  background: #fff1f0;
  color: #ff4d4f;
}

.status-running {
  background: #e6f7ff;
  color: #1890ff;
}
