@import "../../common.wxss";

.summary-row {
  display: flex;
  margin-top: 24rpx;
  gap: 24rpx;
}

.summary-item {
  flex: 1;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.summary-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #07c160;
  line-height: 1.2;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #888;
}

.order-card {
  padding-bottom: 20rpx;
}

.order-head {
  margin-top: 0;
  align-items: flex-start;
}

.addr {
  flex: 1;
  padding-right: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.meta-label {
  color: #888;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.meta-value {
  color: #1a1a1a;
  text-align: right;
  word-break: break-all;
}

.meta-value.muted {
  color: #bbb;
}

.meta-value.warn {
  color: #fa541c;
}
