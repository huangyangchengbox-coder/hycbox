<view class="hyc-page">
  <view class="hyc-card">
    <view class="hyc-row head-row">
      <view>
        <view class="hyc-title">发布管理</view>
        <view class="hyc-sub">当前账号：{{adminName}}{{isSuperAdmin ? '（超级管理员）' : ''}}</view>
      </view>
      <button
        size="mini"
        class="{{showForm ? 'cancel-btn' : 'hyc-btn-primary mini-add'}}"
        bindtap="toggleForm"
      >{{showForm ? '收起' : '发布新物品'}}</button>
    </view>

    <view class="form-wrap {{showForm ? 'form-open' : ''}}">
      <view class="form-inner">
        <view class="picker-label">发布地域</view>
        <picker mode="selector" range="{{scopeOptions}}" value="{{scopeIndex}}" bindchange="onScopeChange">
          <view class="picker-value">{{scopeOptions[scopeIndex]}}</view>
        </picker>

        <block wx:if="{{scope === 'community'}}">
          <view class="picker-label">小区</view>
          <picker mode="selector" range="{{communityNames}}" value="{{communityIndex}}" bindchange="onCommunityChange">
            <view class="picker-value">{{communityNames[communityIndex] || '请选择小区'}}</view>
          </picker>

          <block wx:if="{{hasPhases}}">
            <view class="picker-label">面向范围</view>
            <view class="phase-scope-row">
              <text class="hyc-sub">全部期</text>
              <switch checked="{{allPhases}}" bindchange="onAllPhasesSwitch" color="#07c160" />
            </view>
            <block wx:if="{{!allPhases}}">
              <view class="picker-label">指定期数</view>
              <picker mode="selector" range="{{phaseNames}}" value="{{phaseIndex}}" bindchange="onPhaseChange">
                <view class="picker-value">{{phaseNames[phaseIndex] || '请选择期数'}}</view>
              </picker>
            </block>
          </block>
        </block>
        <view wx:else class="hyc-sub tip-nation">面向全国用户（物流中国）</view>

        <view class="picker-label">物品名称</view>
        <input class="hyc-input" placeholder="如 新鲜苹果" value="{{title}}" bindinput="onTitleInput" />

        <view class="picker-label">计量单位</view>
        <picker mode="selector" range="{{unitOptions}}" value="{{unitIndex}}" bindchange="onUnitChange">
          <view class="picker-value">{{unitOptions[unitIndex]}}</view>
        </picker>
        <input
          wx:if="{{unitIndex === unitOtherIndex}}"
          class="hyc-input"
          placeholder="请输入单位，如 捆 / 盒"
          value="{{customUnit}}"
          bindinput="onCustomUnitInput"
        />

        <view class="picker-label">数量（{{currentUnit}}）</view>
        <input class="hyc-input" type="digit" placeholder="请输入总数量" value="{{totalBags}}" bindinput="onBagsInput" />

        <view class="picker-label">单价（元 / {{currentUnit}}）</view>
        <input class="hyc-input" type="digit" placeholder="如 15.00" value="{{unitPrice}}" bindinput="onUnitPriceInput" />

        <view class="picker-label">图片</view>
        <view class="upload-area" bindtap="chooseImage">
          <image wx:if="{{imageUrl}}" class="hyc-fruit-img" src="{{imageUrl}}" mode="aspectFill" />
          <view wx:else class="upload-placeholder">+ 点击上传图片</view>
        </view>

        <button class="hyc-btn-primary save-btn" bindtap="submitPublish">发布</button>
      </view>
    </view>
  </view>

  <view class="hyc-card">
    <view class="hyc-title">当前发布</view>
    <view class="pub-item" wx:for="{{publications}}" wx:key="id">
      <view class="hyc-row">
        <text class="pub-title">{{item.title}}</text>
        <text class="hyc-tag {{item.status === 'ended' ? 'hyc-tag-done' : 'hyc-tag-pending'}}">
          {{item.status === 'ended' ? '已结束' : '进行中'}}
        </text>
      </view>
      <view class="hyc-sub">
        <text class="scope-tag {{item.scope === 'nationwide' ? 'nation' : 'community'}}">
          {{item.scope === 'nationwide' ? '全国' : '小区'}}
        </text>
        {{item.scope === 'nationwide' ? '物流中国' : ((item.communityName || '') + (item.phaseName ? ' · ' + item.phaseName : ' · 全部期'))}}
      </view>
      <view class="hyc-row">
        <text class="hyc-sub">剩余 {{item.remainBags}}/{{item.totalBags}} {{item.unit || '袋'}}</text>
        <text class="hyc-sub">单价 ¥{{item.unitPrice != null ? item.unitPrice : '-'}}</text>
      </view>
      <view class="hyc-sub">{{item.createdAt}}</view>
      <view class="pub-actions">
        <view
          class="action-btn {{item.scope === 'nationwide' ? 'ship-btn' : 'deliver-btn'}}"
          data-id="{{item.id}}"
          data-title="{{item.title}}"
          data-unit="{{item.unit || '袋'}}"
          data-scope="{{item.scope || 'community'}}"
          catchtap="goDeliverOrShip"
        >{{item.scope === 'nationwide' ? '发货' : '配送'}}</view>
        <view
          class="action-btn detail-btn"
          data-id="{{item.id}}"
          data-title="{{item.title}}"
          data-unit="{{item.unit || '袋'}}"
          data-scope="{{item.scope || 'community'}}"
          catchtap="goPubOrders"
        >登记明细</view>
        <view
          class="end-btn"
          wx:if="{{item.status !== 'ended'}}"
          data-id="{{item.id}}"
          data-title="{{item.title}}"
          catchtap="endActivity"
        >结束活动</view>
      </view>
    </view>
    <view class="hyc-empty" wx:if="{{publications.length === 0}}">暂无发布</view>
  </view>

  <view class="hyc-bottom-bar">
    <view class="hyc-bottom-item active">发布</view>
    <view class="hyc-bottom-item" bindtap="goMine">我的</view>
  </view>
</view>
