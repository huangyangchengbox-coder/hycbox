<view class="hyc-page">
  <view class="hyc-card">
    <view class="hyc-title">发布新水果</view>

    <view class="picker-label">水果名称</view>
    <input class="hyc-input" placeholder="如 新鲜苹果" value="{{title}}" bindinput="onTitleInput" />

    <view class="picker-label">数量（袋）</view>
    <input class="hyc-input" type="number" placeholder="请输入总袋数" value="{{totalBags}}" bindinput="onBagsInput" />

    <view class="picker-label">图片</view>
    <view class="upload-area" bindtap="chooseImage">
      <image wx:if="{{imageUrl}}" class="hyc-fruit-img" src="{{imageUrl}}" mode="aspectFill" />
      <view wx:else class="upload-placeholder">+ 点击上传图片</view>
    </view>

    <button class="hyc-btn-primary" bindtap="submitPublish">发布</button>
  </view>

  <view class="hyc-card">
    <view class="hyc-title">当前发布</view>
    <view class="pub-item" wx:for="{{publications}}" wx:key="id">
      <view class="hyc-row">
        <text>{{item.title}}</text>
        <text class="hyc-sub">剩余 {{item.remainBags}}/{{item.totalBags}}</text>
      </view>
      <view class="hyc-sub">{{item.createdAt}}</view>
    </view>
    <view class="hyc-empty" wx:if="{{publications.length === 0}}">暂无发布</view>
  </view>

  <view class="hyc-bottom-bar">
    <view class="hyc-bottom-item active">发布</view>
    <view class="hyc-bottom-item" bindtap="goDelivery">配送管理</view>
    <view class="hyc-bottom-item" bindtap="switchRole">切换身份</view>
  </view>
</view>
