@import "../../common.wxss";

.picker-label {
  font-size: 26rpx;
  color: #666;
  margin-top: 20rpx;
}

.upload-area {
  margin-top: 12rpx;
}

.upload-placeholder {
  height: 320rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
  border: 2rpx dashed #ddd;
}

.pub-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.pub-item:last-child {
  border-bottom: none;
}
