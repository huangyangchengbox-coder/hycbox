@import "../../common.wxss";

.page {
  padding: 24rpx 24rpx 160rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f6f8;
}

.head-tip {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.loc-tip {
  font-size: 22rpx;
  color: #07c160;
  margin-bottom: 12rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.row-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.row-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.act {
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  border-radius: 10rpx;
}

.act-nav {
  background: #e6f4ff;
  color: #1677ff;
}

.act-call {
  background: #f6ffed;
  color: #389e0d;
}

.act-arrive {
  background: #fff7e6;
  color: #d48806;
}

.act-done {
  background: #07c160;
  color: #fff;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  z-index: 50;
}

.bottom-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  color: #333;
}
