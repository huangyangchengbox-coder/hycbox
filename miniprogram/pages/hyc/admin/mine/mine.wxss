@import "../../common.wxss";

.menu-card {
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.menu-title {
  font-size: 30rpx;
  color: #1a1a1a;
}

.menu-arrow {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #2f6bff;
  line-height: 1;
}

.bind-input {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
}

