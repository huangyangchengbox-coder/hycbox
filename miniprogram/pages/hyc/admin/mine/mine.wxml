<view class="hyc-page">
  <view class="hyc-card">
    <view class="hyc-title">我的</view>
    <view class="hyc-sub">当前账号：{{adminName}}{{isSuperAdmin ? '（超级管理员）' : ''}}</view>
  </view>

  <view class="hyc-card menu-card">
    <view class="menu-item" bindtap="goUser">
      <view>
        <view class="menu-title">进入用户端</view>
        <view class="hyc-sub">查看发布 / 我的订单</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{isSuperAdmin}}" bindtap="goManagers">
      <view>
        <view class="menu-title">管理员账号</view>
        <view class="hyc-sub">添加 / 删除管理员</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="hyc-bottom-bar">
    <view class="hyc-bottom-item" bindtap="goPublish">发布</view>
    <view class="hyc-bottom-item" bindtap="goDelivery">配送</view>
    <view class="hyc-bottom-item active">我的</view>
  </view>
</view>
