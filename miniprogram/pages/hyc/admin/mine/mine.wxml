<view class="hyc-page">
  <admin-notice-bar></admin-notice-bar>
  <view class="hyc-card">
    <view class="hyc-title">我的</view>
    <view class="hyc-sub">当前账号：{{adminName}}{{isSuperAdmin ? '（超级管理员）' : ''}}</view>
  </view>

  <view class="hyc-card menu-card">
    <view class="menu-item" bindtap="onSubscribeTap">
      <view class="menu-main">
        <view class="menu-title">微信新单提醒</view>
        <view class="hyc-sub" wx:if="{{needSubscribe}}">一次性订阅 · 点此开启/续订（推一条需再订一次）</view>
        <view class="hyc-sub" wx:else>已绑定 · 剩余可推 {{subscribeQuota}} 条，用完请再点续订</view>
      </view>
      <text class="menu-arrow">{{needSubscribe ? '开启' : '续订'}}</text>
    </view>
    <view class="menu-item" bindtap="onBindMpTap">
      <view class="menu-main">
        <view class="menu-title">绑定小程序号</view>
        <view class="hyc-sub" wx:if="{{qrWxBound}}">已绑定 · 扫码登录电脑端无需再输密码</view>
        <view class="hyc-sub" wx:else>绑定后扫码确认电脑端登录免密</view>
      </view>
      <text class="menu-arrow">{{qrWxBound ? '已绑定' : '绑定'}}</text>
    </view>
    <view class="menu-item" bindtap="onScanWebLogin">
      <view>
        <view class="menu-title">扫码登录电脑端</view>
        <view class="hyc-sub">扫描网页登录页二维码并确认</view>
      </view>
      <text class="menu-arrow">扫码</text>
    </view>
    <view class="menu-item" bindtap="goUser">
      <view>
        <view class="menu-title">进入用户端</view>
        <view class="hyc-sub">查看发布 / 我的订单</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{isSuperAdmin}}" bindtap="goManagers">
      <view>
        <view class="menu-title">管理员账号</view>
        <view class="hyc-sub">添加 / 删除管理员</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="hyc-card" wx:if="{{showBindForm}}">
    <view class="hyc-title">验证管理员账号</view>
    <view class="hyc-sub">绑定当前微信到电脑端管理账号（仅需一次）</view>
    <input class="bind-input" placeholder="管理员账号" value="{{bindUsername}}" bindinput="onBindUsernameInput" />
    <input class="bind-input" password placeholder="管理员密码" value="{{bindPassword}}" bindinput="onBindPasswordInput" />
    <button class="hyc-btn-primary" bindtap="submitBindForm" loading="{{bindLoading}}" disabled="{{bindLoading}}">确认绑定</button>
    <button class="hyc-btn-plain" bindtap="cancelBindForm">取消</button>
  </view>

  <view class="hyc-bottom-bar">
    <view class="hyc-bottom-item" bindtap="goPublish">发布</view>
    <view class="hyc-bottom-item active">我的</view>
  </view>
</view>
