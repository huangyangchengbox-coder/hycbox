@import "../../common.wxss";

.link-btn {
  font-size: 26rpx;
  color: #2f6bff;
  flex-shrink: 0;
}

.tab-row {
  display: flex;
  margin-top: 24rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 10rpx;
}

.tab-item.on {
  background: #fff;
  color: #07c160;
  font-weight: 600;
}

.province-head {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.qty {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;
}

.pay-expect {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;
}

.pay-edit-row {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.pay-edit-label {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.qty-ctrl {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.qty-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  background: #f5f6f8;
  border-radius: 8rpx;
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
}

.pay-amount-edit {
  display: flex;
  align-items: center;
  background: #f5f6f8;
  border-radius: 8rpx;
  padding: 0 12rpx;
  min-width: 140rpx;
  margin: 0 8rpx;
}

.pay-yen {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;
  margin-right: 4rpx;
}

.pay-amount-input {
  width: 120rpx;
  height: 56rpx;
  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;
  text-align: center;
}

.pay-method-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.pay-chip {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f6f8;
  border-radius: 8rpx;
  border: 1rpx solid transparent;
}

.pay-chip.on {
  color: #07c160;
  background: #e8f8ef;
  border-color: #07c160;
  font-weight: 600;
}

.ship-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.ship-btn {
  margin: 0 !important;
}

.export-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.export-btn {
  margin: 0 !important;
  flex-shrink: 0;
}
