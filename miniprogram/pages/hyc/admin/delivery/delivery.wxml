<view class="page">
  <admin-notice-bar></admin-notice-bar>
  <view class="stats-card">
    <view class="stats">
      <view class="stat">
        <view class="num">{{stats.pendingCount}}</view>
        <view class="label">待配送户</view>
      </view>
      <view class="stat">
        <view class="num">{{stats.pendingBags}}</view>
        <view class="label">待配送{{qtyUnit}}</view>
      </view>
      <view class="stat">
        <view class="num">{{stats.completedCount}}</view>
        <view class="label">已完成户</view>
      </view>
      <view class="stat">
        <view class="num">{{stats.completedBags}}</view>
        <view class="label">已完成{{qtyUnit}}</view>
      </view>
    </view>
    <view class="stats stats-extra">
      <view class="stat">
        <view class="num warn">{{stats.extraCount}}</view>
        <view class="label">超申请户</view>
      </view>
      <view class="stat">
        <view class="num warn">{{stats.extraBags}}</view>
        <view class="label">超出申请{{qtyUnit}}</view>
      </view>
    </view>
  </view>
  <view class="status">{{statusText}}</view>
  <view class="loc-tip" wx:if="{{locationTip}}">{{locationTip}}</view>

  <view class="card picker-card" wx:if="{{currentPubTitle}}">
    <view class="current-tip">{{currentPubTitle}}</view>
  </view>

  <view wx:if="{{hasGroups}}">
    <view class="unit-block" wx:for="{{buildingGroups}}" wx:key="groupKey">
      <view class="unit-head">
        <view class="unit-head-main" bindtap="toggleGroup" data-index="{{index}}">
          <text class="unit-title">{{item.phaseName}}{{item.buildingName}} {{item.unit}}单元</text>
          <text class="unit-meta">{{item.orderCount}}户 · {{item.totalBags}}{{qtyUnit}} {{item.expanded ? '▾' : '▸'}}</text>
        </view>
        <view class="unit-batch" catchtap="deliverUnit" data-index="{{index}}">整单元送达</view>
      </view>
      <view class="room-grid" wx:if="{{item.expanded}}">
        <view
          class="room-chip {{order.selected ? 'selected' : ''}} {{order.remark ? 'has-remark' : ''}}"
          wx:for="{{item.orders}}"
          wx:for-item="order"
          wx:for-index="oindex"
          wx:key="id"
          data-gid="{{index}}"
          data-oindex="{{oindex}}"
          data-oid="{{order.id}}"
          catchtap="toggleSelect"
        >
          <view
            class="remark-badge"
            wx:if="{{order.remark}}"
            data-gid="{{index}}"
            data-oindex="{{oindex}}"
            catchtap="showRemark"
          >!</view>
          <text class="qty-badge">{{order.quantity}}</text>
          <text class="room-no">{{order.roomNo}}</text>
          <text class="room-name" wx:if="{{order.userName}}">{{order.userName}}</text>
          <text class="room-remark" wx:if="{{order.remark}}">{{order.remark}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !hasGroups}}">{{emptyHint || '暂无待配送订单'}}</view>

  <view class="batch-bar" wx:if="{{selectedCount > 0 && !showConfirm}}">
    <view class="batch-info">已选 {{selectedCount}} 户 · {{selectedBags}} {{qtyUnit}}</view>
    <view class="batch-actions">
      <view class="batch-clear" bindtap="clearSelection">清空</view>
      <view class="batch-confirm" bindtap="openConfirm">确认送达</view>
    </view>
  </view>

  <!-- 确认送达：可调整每户数量 + 收款 -->
  <view class="mask" wx:if="{{showConfirm}}" catchtouchmove="noop" bindtap="closeConfirm"></view>
  <view class="confirm-panel" wx:if="{{showConfirm}}" catchtap="noop">
    <view class="confirm-title">确认送达（可改数量与收款金额）</view>
    <scroll-view scroll-y class="confirm-list" enable-flex="{{true}}">
      <view class="confirm-item" wx:for="{{confirmList}}" wx:key="id">
        <view class="confirm-row">
          <text class="confirm-room">{{item.roomNo}}</text>
          <text class="confirm-name" wx:if="{{item.userName}}">{{item.userName}}</text>
        </view>
        <view class="confirm-remark" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
        <view class="confirm-qty-row">
          <text class="confirm-qty-label">送达（申请{{item.quantity}}{{item.qtyUnit}}）</text>
          <view class="qty-ctrl">
            <view class="qty-btn" data-index="{{index}}" bindtap="decDeliverQty">−</view>
            <text class="qty-num">{{item.deliverQty}}</text>
            <view class="qty-btn" data-index="{{index}}" bindtap="incDeliverQty">+</view>
          </view>
        </view>
        <view class="confirm-pay-row">
          <text class="confirm-qty-label">收款（参考 ¥{{item.expectAmount}}）</text>
          <view class="qty-ctrl">
            <view class="qty-btn" data-index="{{index}}" data-delta="-1" bindtap="changePayAmount">−</view>
            <view class="pay-amount-edit">
              <text class="pay-yen">¥</text>
              <input
                class="pay-amount-input"
                type="digit"
                value="{{item.payAmount}}"
                data-index="{{index}}"
                bindinput="onPayAmountInput"
              />
            </view>
            <view class="qty-btn" data-index="{{index}}" data-delta="1" bindtap="changePayAmount">+</view>
          </view>
        </view>
        <view class="pay-method-row">
          <view
            class="pay-chip {{item.payMethod === 'wechat' ? 'on' : ''}}"
            data-index="{{index}}"
            data-method="wechat"
            bindtap="onPayMethodTap"
          >微信</view>
          <view
            class="pay-chip {{item.payMethod === 'alipay' ? 'on' : ''}}"
            data-index="{{index}}"
            data-method="alipay"
            bindtap="onPayMethodTap"
          >支付宝</view>
        </view>
      </view>
    </scroll-view>
    <view class="confirm-footer">
      <view class="confirm-total-wrap">
        <text class="confirm-total">共 {{confirmCount}} 户 · {{confirmBags}} {{qtyUnit}}</text>
        <text class="confirm-pay-total">收款合计 ¥{{confirmPayTotal}}</text>
      </view>
      <view class="confirm-actions">
        <view class="batch-clear" bindtap="closeConfirm">取消</view>
        <view class="batch-confirm" bindtap="submitConfirm">提交送达</view>
      </view>
    </view>
  </view>

  <!-- 备注全文提示 -->
  <view class="remark-mask" wx:if="{{remarkTip.show}}" catchtouchmove="noop" bindtap="hideRemark"></view>
  <view class="remark-tip" wx:if="{{remarkTip.show}}" catchtap="noop">
    <view class="remark-tip-title">{{remarkTip.roomNo}} 备注</view>
    <view class="remark-tip-name" wx:if="{{remarkTip.userName}}">{{remarkTip.userName}}</view>
    <view class="remark-tip-content">{{remarkTip.content}}</view>
    <view class="remark-tip-ok" bindtap="hideRemark">知道了</view>
  </view>

  <view class="tabbar">
    <view class="tab on" bindtap="goPublish">返回发布</view>
  </view>
</view>
