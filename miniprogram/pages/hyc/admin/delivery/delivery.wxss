.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 16rpx 16rpx 220rpx;
  box-sizing: border-box;
}

.stats-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 0 12rpx;
  margin-bottom: 12rpx;
}

.stats {
  display: flex;
  padding: 0;
  margin-bottom: 0;
  background: transparent;
}

.stats-extra {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #f0f0f0;
}

.stat {
  flex: 1;
  text-align: center;
}

.num {
  font-size: 30rpx;
  font-weight: 700;
  color: #07c160;
}

.num.warn {
  color: #fa8c16;
}

.label {
  font-size: 18rpx;
  color: #888;
  margin-top: 4rpx;
}

.status {
  text-align: center;
  font-size: 22rpx;
  color: #07c160;
  margin-bottom: 12rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.picker-card {
  padding: 8rpx 16rpx;
}

.picker {
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #333;
}

.unit-block {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.unit-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  gap: 12rpx;
}

.unit-head-main {
  flex: 1;
  min-width: 0;
}

.unit-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.unit-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #888;
}

.unit-batch {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8ef;
  border-radius: 8rpx;
}

.room-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.room-chip {
  position: relative;
  width: calc(25% - 12rpx);
  margin: 6rpx;
  box-sizing: border-box;
  background: #f7faf8;
  border: 1rpx solid #d9f0e3;
  border-radius: 10rpx;
  padding: 18rpx 8rpx 12rpx;
  text-align: center;
  min-height: 88rpx;
}

.room-chip.has-remark {
  border-color: #faad14;
  background: #fffbe6;
  min-height: 110rpx;
}

.room-chip.selected {
  border-color: #07c160;
  background: #e8f8ef;
  box-shadow: inset 0 0 0 2rpx #07c160;
}

.remark-badge {
  position: absolute;
  top: 0;
  left: 0;
  width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 10rpx 0 10rpx 0;
  background: #faad14;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

.qty-badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 0 10rpx 0 10rpx;
  background: #07c160;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  text-align: center;
}

.room-no {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.2;
}

.room-name {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #999;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.room-remark {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #d48806;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remark-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 300;
}

.remark-tip {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 35%;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  z-index: 301;
  box-sizing: border-box;
}

.remark-tip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.remark-tip-name {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}

.remark-tip-content {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  background: #fff7e6;
  padding: 20rpx;
  border-radius: 10rpx;
  word-break: break-all;
}

.remark-tip-ok {
  margin-top: 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;
  padding: 12rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(98rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 16rpx 24rpx;
  z-index: 98;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.batch-info {
  font-size: 26rpx;
  color: #333;
}

.batch-actions {
  display: flex;
  align-items: center;
}

.batch-clear {
  font-size: 26rpx;
  color: #888;
  padding: 12rpx 20rpx;
}

.batch-confirm {
  margin-left: 8rpx;
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 10rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
}

.confirm-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.confirm-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.confirm-list {
  flex: 1;
  max-height: 48vh;
}

.confirm-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.confirm-item:last-child {
  border-bottom: none;
}

.confirm-row {
  display: flex;
  align-items: baseline;
}

.confirm-room {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.confirm-name {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #888;
}

.confirm-remark {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #fa8c16;
  background: #fff7e6;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
}

.confirm-qty-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.confirm-qty-label {
  font-size: 24rpx;
  color: #666;
}

.qty-ctrl {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  background: #f5f6f8;
  border-radius: 8rpx;
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
}

.qty-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #07c160;
}

.confirm-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.confirm-total {
  font-size: 26rpx;
  color: #333;
}

.confirm-actions {
  display: flex;
  align-items: center;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 99;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 24rpx;
  color: #666;
}

.tab.on {
  color: #07c160;
  font-weight: 600;
}
