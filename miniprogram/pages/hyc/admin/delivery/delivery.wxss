@import "../../common.wxss";

.stats-card {
  margin-top: 0;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.picker-label {
  font-size: 26rpx;
  color: #666;
}

.picker-value {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 8rpx;
}

.building-group {
  padding-bottom: 8rpx;
}

.expand-icon {
  color: #999;
  font-size: 24rpx;
}

.order-item {
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.mini-btn {
  margin: 0 !important;
  padding: 0 20rpx !important;
  font-size: 24rpx !important;
  line-height: 2 !important;
}
