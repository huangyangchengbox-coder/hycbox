<view class="hyc-page">
  <view class="section-title">可登记发布</view>
  <view class="hyc-card" wx:for="{{publications}}" wx:key="id">
    <view class="pub-img-row" wx:if="{{item.images.length}}">
      <image
        class="pub-img-thumb"
        wx:for="{{item.images}}"
        wx:for-item="img"
        wx:key="*this"
        src="{{img}}"
        mode="aspectFill"
        data-id="{{item.id}}"
        data-url="{{img}}"
        bindtap="previewPubImages"
      />
    </view>
    <view class="pub-img-tip" wx:if="{{item.images.length}}">点击图片查看大图</view>
    <view class="hyc-title" style="margin-top:16rpx">{{item.title}}</view>
    <view class="hyc-sub">发布人：{{item.adminName || '管理者'}} · {{item.createdAt}}</view>
    <view class="hyc-row">
      <text>剩余 <text class="hyc-stat-num">{{item.remainBags}}</text> {{item.unit || '袋'}}</text>
      <text class="hyc-sub">共 {{item.totalBags}} {{item.unit || '袋'}}</text>
    </view>
    <view class="pub-action-row">
      <button
        class="detail-btn"
        data-id="{{item.id}}"
        data-title="{{item.title}}"
        bindtap="goAiDetail"
      >物品详情</button>
      <button
        class="hyc-btn-primary order-btn"
        data-id="{{item.id}}"
        data-can="{{item.remainBags > 0 ? '1' : '0'}}"
        bindtap="goOrder"
        disabled="{{item.remainBags <= 0}}"
      >
        {{item.remainBags > 0 ? '登记物流' : '已领完'}}
      </button>
    </view>
  </view>
  <view class="hyc-empty soft" wx:if="{{!loading && publications.length === 0}}">暂无可登记发布</view>

  <view class="section-title">我的登记</view>
  <view class="hyc-card order-card" wx:for="{{orders}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view class="hyc-row">
      <text class="hyc-title" style="font-size:30rpx">{{item.publicationTitle || item.userName || '物流登记'}}</text>
      <text class="hyc-tag {{item.status === 'shipped' ? 'hyc-tag-done' : 'hyc-tag-pending'}}">
        {{item.statusText}}
      </text>
    </view>
    <view class="hyc-sub">{{item.province}} · {{item.address}}</view>
    <view class="hyc-sub">{{item.phone}} · {{item.quantity}} {{item.qtyUnit || '袋'}}</view>
    <view class="hyc-sub">登记：{{item.createdAt}}</view>
    <view class="detail-hint">查看详情 ›</view>
  </view>
  <view class="hyc-empty soft" wx:if="{{!loading && orders.length === 0}}">暂无登记记录</view>
  <view class="hyc-empty" wx:if="{{loading}}">加载中...</view>

  <view class="hyc-bottom-bar">
    <view class="hyc-bottom-item" bindtap="goHome">首页</view>
    <view class="hyc-bottom-item active">我的物流</view>
    <view class="hyc-bottom-item" bindtap="goProfile">我的</view>
  </view>
</view>
