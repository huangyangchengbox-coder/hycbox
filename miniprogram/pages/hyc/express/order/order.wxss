@import "../../common.wxss";

.picker-label {
  font-size: 26rpx;
  color: #666;
  margin-top: 20rpx;
}

.picker-value {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 8rpx;
  font-size: 28rpx;
}

.quantity-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.quantity-num {
  font-size: 40rpx;
  font-weight: 700;
  margin: 0 40rpx;
  min-width: 60rpx;
  text-align: center;
}

.submit-btn {
  margin: 24rpx;
}
